{
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "[dockercompose]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[odin]": {},
  "[python]": {
    "editor.formatOnType": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "vscode.typescript-language-features"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "chat.agent.enabled": false,
  "chat.commandCenter.enabled": false,
  "chat.disableAIFeatures": true,
  "chat.viewSessions.orientation": "stacked",
  "csharp.inlayHints.enableInlayHintsForImplicitObjectCreation": true,
  "csharp.inlayHints.enableInlayHintsForImplicitVariableTypes": true,
  "csharp.inlayHints.enableInlayHintsForLambdaParameterTypes": true,
  "csharp.inlayHints.enableInlayHintsForTypes": true,
  "debug.allowBreakpointsEverywhere": true,
  "debug.console.collapseIdenticalLines": false,
  "debug.terminal.clearBeforeReusing": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "docker.extension.dockerEngineAvailabilityPrompt": false,
  "docker.extension.enableComposeLanguageServer": false,
  "dotnet.formatting.organizeImportsOnFormat": true,
  "dotnet.inlayHints.enableInlayHintsForIndexerParameters": true,
  "dotnet.inlayHints.enableInlayHintsForLiteralParameters": true,
  "dotnet.inlayHints.enableInlayHintsForObjectCreationParameters": true,
  "dotnet.inlayHints.enableInlayHintsForOtherParameters": true,
  "dotnet.inlayHints.enableInlayHintsForParameters": true,
  "editor.accessibilitySupport": "off",
  "editor.fontFamily": "'CaskaydiaMono NF', monospace",
  "editor.minimap.enabled": false,
  "editor.renderControlCharacters": false,
  "editor.semanticHighlighting.enabled": true,
  "editor.suggestSelection": "first",
  "explorer.confirmDelete": false,
  "extensions.ignoreRecommendations": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "go.toolsManagement.autoUpdate": true,
  "json.schemaDownload.trustedDomains": {
    "https://aka.ms": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  },
  "jupyter.askForKernelRestart": false,
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left"
  },
  "notebook.lineNumbers": "on",
  "opencodeWorkbench.serverEnvironmentFile": "~/.config/opencode-workbench/server.env",
  "opencodeWorkbench.serverUrl": "http://127.0.0.1:4096",
  "opencodeWorkbench.serverUsername": "opencode",
  "python.analysis.typeCheckingMode": "standard",
  "redhat.telemetry.enabled": false,
  "scm.defaultViewMode": "tree",
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.allowChords": true,
  "terminal.integrated.sendKeybindingsToShell": false,
  "terminal.integrated.commandsToSkipShell": [
    "-workbench.action.quickOpen"
  ],
  "terminal.integrated.shellIntegration.enabled": true,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.stickyScroll.enabled": false,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.copyOnSelection": false,
  "terminal.integrated.rightClickBehavior": "default",
  "terminal.integrated.middleClickBehavior": "paste",
  "terminal.integrated.fontFamily": "CaskaydiaMono NF",
  "terminal.integrated.gpuAcceleration": "auto",
  "terminal.integrated.profiles.linux": {
    "fish": {
      "path": "/usr/bin/fish",
      "icon": "terminal"
    },
    "bash": {
      "path": "/usr/bin/bash",
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "/usr/bin/zsh",
      "icon": "terminal"
    }
  },
  "vsicons.dontShowNewVersionMessage": true,
  "window.commandCenter": false,
  "window.titleBarStyle": "native",
  "workbench.activityBar.location": "top",
  "workbench.browser.searchEngine": "duckduckgo",
  "workbench.colorTheme": "Nulifyer",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook"
  },
  "workbench.iconTheme": "vscode-icons",
  "workbench.layoutControl.enabled": false,
  "workbench.settings.applyToAllProfiles": [
    "editor.fontFamily"
  ],
  "workbench.startupEditor": "none",
  "xml.format.maxLineWidth": 0,
  "xml.server.preferBinary": true,
  "zig.zls.enabled": "on",
  "zig.zls.inlayHintsShowParameterName": false,
  "zig.zls.warnStyle": true
}
