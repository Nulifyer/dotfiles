{
  "$schema": "../.dotfiles/module.schema.json",
  "version": 1,
  "name": "kde",
  "when": {
    "desktop": [
      "kde"
    ]
  },
  "dependencies": {
    "commands": {
      "managed": [
        "kbuildsycoca6",
        "kreadconfig6",
        "kwriteconfig6",
        "plasma-apply-colorscheme"
      ]
    },
    "packages": {
      "arch": {
        "managed": [
          "kconfig",
          "plasma-workspace",
          "ttf-cascadia-mono-nerd"
        ]
      }
    }
  },
  "deployments": [
    {
      "name": "color-schemes",
      "source": ".",
      "target": ".local/share/color-schemes",
      "kind": "contents",
      "install": "link",
      "generated": true,
      "exclude": [
        "apply.sh",
        "apply_scheme.py",
        "check.sh",
        "dotfiles.json",
        "reload.sh",
        "settings.json"
      ]
    }
  ]
}
