)
readonly -a KDE_NESTED_SETTINGS=(
    'powerdevilrc|AC|Display|DimDisplayIdleTimeoutSec|-1'
    'powerdevilrc|AC|Display|DimDisplayWhenIdle|false'
    'powerdevilrc|AC|Display|TurnOffDisplayIdleTimeoutSec|-1'
    'powerdevilrc|AC|Display|TurnOffDisplayWhenIdle|false'
    'powerdevilrc|AC|SuspendAndShutdown|AutoSuspendAction|0'
)

usage() {
    cat <<'EOF'
Usage: ./dotfiles COMMAND

Commands:
  link         Create or refresh links from link-config.json
  apply        Apply settings that cannot safely be linked
  theme        Generate local theme files from colors.json
  workbench    Install, update, inspect, or roll back OpenCode Workbench
  check        Validate source files, generated files, and installed links
  doctor       Report required and optional setup dependencies
  update       Pull with --ff-only, then link, apply, and validate
  status       Show repository and package status
  unlink       Remove links managed by link-config.json
  help         Show this help

Environment:
  DOTFILES_TARGET  Override the deployment target (default: $HOME)
EOF
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'dotfiles: required command not found: %s\n' "$1" >&2
        exit 1
    fi
}

doctor_command() {
    local strict=false
    if [[ "${1-}" == --strict ]]; then
        strict=true
        shift
    fi
    if [[ "$#" -ne 0 ]]; then
        printf 'Usage: ./dotfiles doctor [--strict]\n' >&2
        return 2
    fi

    local missing_required=false
    local missing_any=false
    local class package
    local -a command_specs=(
        'required|bash'
        'required|curl'
        'required|git'
        'required|gh'
        'required|jq'
        'required|python3'
        'required|sha256sum'
        'managed|alacritty'
        'managed|fish'
        'managed|fzf'
        'managed|kbuildsycoca6'
        'managed|kreadconfig6'
        'managed|kitty'
        'managed|plasma-apply-colorscheme'
        'managed|kwriteconfig6'
        'managed|spectacle'
        'managed|code'
        'managed|zsh'
        'optional|bat'
        'optional|chafa'
        'optional|curl'
        'optional|eza'
    )

    printf 'Commands:\n'
    local spec command_name
    for spec in "${command_specs[@]}"; do
        IFS='|' read -r class command_name <<<"$spec"
        if command -v "$command_name" >/dev/null 2>&1; then
            printf '  ok       %-8s %s\n' "$class" "$command_name"
        else
            printf '  missing  %-8s %s\n' "$class" "$command_name"
            missing_any=true
            [[ "$class" == required ]] && missing_required=true
        fi
    done

    if command -v pacman >/dev/null 2>&1; then
        printf '\nArch packages:\n'
        while read -r class package; do
            [[ -n "${class:-}" ]] || continue
            [[ "$class" == \#* ]] && continue
            if pacman -T "$package" >/dev/null 2>&1; then
                printf '  ok       %-8s %s\n' "$class" "$package"
            else
                printf '  missing  %-8s %s\n' "$class" "$package"
                missing_any=true
                [[ "$class" == required ]] && missing_required=true
            fi
        done <"$DOTFILES_ROOT/packages.arch"
    else
        printf '\nArch package checks skipped: pacman is unavailable.\n'
    fi

    if [[ "$missing_required" == true ]] ||
        [[ "$strict" == true && "$missing_any" == true ]]; then
        return 1
    fi
}

kde_theme_root() {
    printf '%s\n' "$THEME_LOCAL_STATE"
}

kde_icon_theme() {
    local variant_file
    variant_file="$(kde_theme_root)/variant"
    if [[ -r "$variant_file" ]] && [[ "$(<"$variant_file")" == light ]]; then
        printf '%s\n' breeze
    else
        printf '%s\n' breeze-dark
    fi
}

kde_write_setting() {
    local entry=$1
    local file group key value
    IFS='|' read -r file group key value <<<"$entry"
    kwriteconfig6 --file "$file" --group "$group" --key "$key" -- "$value"
}

kde_write_nested_setting() {
    local entry=$1
    local file group subgroup key value
    IFS='|' read -r file group subgroup key value <<<"$entry"
    kwriteconfig6 --file "$file" --group "$group" --group "$subgroup" \
        --key "$key" -- "$value"
}

kde_scheme_path() {
    local scheme
    IFS= read -r scheme <"$(kde_theme_root)/kde-scheme"
    printf '%s/color-schemes/%s.colors\n' \
        "${XDG_DATA_HOME:-$HOME/.local/share}" "$scheme"
}

kde_apply_color_scheme() {
    local scheme_file
    scheme_file="$(kde_scheme_path)"
    if [[ ! -r "$scheme_file" ]]; then
        printf 'dotfiles: linked KDE color scheme is missing: %s\n' \
            "$scheme_file" >&2
        return 1
    fi

    require_command plasma-apply-colorscheme

    local current_scheme scheme
    current_scheme="$(
        kreadconfig6 --file kdeglobals --group General --key ColorScheme
    )"
    scheme="$(basename -- "$scheme_file" .colors)"

    # Force Plasma to reapply the current scheme so KWin receives the color
    # change notification when a generated scheme is updated in place.
    kwriteconfig6 --file kdeglobals --group General --key ColorScheme \
        -- __nulifyer_refresh__
    if ! plasma-apply-colorscheme "$scheme" >/dev/null; then
        kwriteconfig6 --file kdeglobals --group General --key ColorScheme \
            -- "$current_scheme"
        return 1
    fi
}

breeze_project_picker_exception_group() {
    local index group enabled pattern exception_type hide_title_bar mask
    local first_free=''

    for ((index = 0; index < 100; index++)); do
        group="Windeco Exception $index"
        enabled="$(kreadconfig6 --file breezerc --group "$group" \
            --key Enabled 2>/dev/null)"
        pattern="$(kreadconfig6 --file breezerc --group "$group" \
            --key ExceptionPattern 2>/dev/null)"
        exception_type="$(kreadconfig6 --file breezerc --group "$group" \
            --key ExceptionType 2>/dev/null)"
        hide_title_bar="$(kreadconfig6 --file breezerc --group "$group" \
            --key HideTitleBar 2>/dev/null)"
        mask="$(kreadconfig6 --file breezerc --group "$group" \
            --key Mask 2>/dev/null)"

        if [[ "$pattern" == nulifyer-project-picker ]]; then
            printf '%s\n' "$group"
            return
        fi
        if [[ -z "$first_free" && -z "$enabled" && -z "$pattern" &&
            -z "$exception_type" && -z "$hide_title_bar" && -z "$mask" ]]; then
            first_free=$group
        fi
    done

    [[ -n "$first_free" ]] || return 1
    printf '%s\n' "$first_free"
}

apply_project_picker_window_rules() {
    local exception_group
    exception_group="$(breeze_project_picker_exception_group)" || {
        printf 'dotfiles: no free Breeze window exception slot\n' >&2
        return 1
    }
    kwriteconfig6 --file breezerc --group "$exception_group" \
        --key Enabled -- true
    kwriteconfig6 --file breezerc --group "$exception_group" \
        --key ExceptionPattern -- nulifyer-project-picker
    kwriteconfig6 --file breezerc --group "$exception_group" \
        --key ExceptionType -- 0
    kwriteconfig6 --file breezerc --group "$exception_group" \
        --key HideTitleBar -- true
    kwriteconfig6 --file breezerc --group "$exception_group" \
        --key Mask -- 0

    local rule_id=nulifyer-project-picker
    local rules
    rules="$(kreadconfig6 --file kwinrulesrc --group General --key rules)"
    if [[ ",$rules," != *",$rule_id,"* ]]; then
        rules="${rules:+$rules,}$rule_id"
        kwriteconfig6 --file kwinrulesrc --group General --key rules -- "$rules"
    fi
}

apply_kde_settings() {
    require_command kbuildsycoca6

    local entry
    kde_apply_color_scheme

    for entry in "${KDE_SETTINGS[@]}"; do
        kde_write_setting "$entry"
    done
    for entry in "${KDE_NESTED_SETTINGS[@]}"; do
        kde_write_nested_setting "$entry"
    done
    apply_project_picker_window_rules
    kwriteconfig6 --file kdeglobals --group Icons --key Theme \
        -- "$(kde_icon_theme)"

    if command -v qdbus6 >/dev/null 2>&1; then
        qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
        if qdbus6 org.kde.kglobalaccel >/dev/null 2>&1; then
            qdbus6 org.kde.kglobalaccel /kglobalaccel \
                org.kde.KGlobalAccel.unregister \
                nulifyer-project-picker.desktop _launch >/dev/null 2>&1 || true
        fi
    fi
    kbuildsycoca6 >/dev/null

    printf 'Applied portable KDE settings and the selected color scheme.\n'
}

apply_brave_settings() {
    local preferences="$DOTFILES_TARGET/.config/BraveSoftware/Brave-Browser/Default/Preferences"
    [[ -f "$preferences" ]] || return

    local temporary
    temporary="$(mktemp "$preferences.tmp.XXXXXX")"
    if ! jq '.browser.custom_chrome_frame = false' \
        "$preferences" >"$temporary"; then
        rm -f -- "$temporary"
        return 1
    fi
    chmod --reference="$preferences" "$temporary"
    mv -f -- "$temporary" "$preferences"
    printf 'Applied Brave native window decorations.\n'
}

kde_check_value() {
    local file=$1
    local group=$2
    local key=$3
    local expected=$4
    local actual
    actual="$(
        kreadconfig6 --file "$file" --group "$group" --key "$key" 2>/dev/null
    )"

    if [[ "$actual" != "$expected" ]]; then
        printf 'dotfiles: KDE drift: %s [%s] %s = %q; expected %q\n' \
            "$file" "$group" "$key" "$actual" "$expected" >&2
        return 1
    fi
}

kde_check_nested_value() {
    local file=$1
    local group=$2
    local subgroup=$3
    local key=$4
    local expected=$5
    local actual
    actual="$(
        kreadconfig6 --file "$file" --group "$group" --group "$subgroup" \
            --key "$key" 2>/dev/null
    )"

    if [[ "$actual" != "$expected" ]]; then
        printf 'dotfiles: KDE drift: %s [%s][%s] %s = %q; expected %q\n' \
            "$file" "$group" "$subgroup" "$key" "$actual" "$expected" >&2
        return 1
    fi
}

kde_check_color_scheme() {
    local scheme_file
    scheme_file="$(kde_scheme_path)"
    if [[ ! -r "$scheme_file" ]]; then
        printf 'dotfiles: linked KDE color scheme is missing: %s\n' \
            "$scheme_file" >&2
        return 1
    fi

    python3 "$DOTFILES_ROOT/.theme/check_kde.py" \
        "$scheme_file" \
        "${XDG_CONFIG_HOME:-$HOME/.config}/kdeglobals"
}

check_kde_settings() {
    command -v kreadconfig6 >/dev/null 2>&1 || return

    local entry file group subgroup key expected
    local failed=false
    local state_root
    state_root="$(kde_theme_root)"

    for entry in "${KDE_SETTINGS[@]}"; do
        IFS='|' read -r file group key expected <<<"$entry"
        kde_check_value "$file" "$group" "$key" "$expected" || failed=true
    done
    for entry in "${KDE_NESTED_SETTINGS[@]}"; do
        IFS='|' read -r file group subgroup key expected <<<"$entry"
        kde_check_nested_value \
            "$file" "$group" "$subgroup" "$key" "$expected" || failed=true
    done
    kde_check_value kdeglobals Icons Theme "$(kde_icon_theme)" || failed=true

    local exception_group
    exception_group="$(breeze_project_picker_exception_group)"
    if [[ -z "$exception_group" ]]; then
        printf 'dotfiles: Breeze project picker exception is missing\n' >&2
        failed=true
    else
        kde_check_value breezerc "$exception_group" Enabled true || failed=true
        kde_check_value breezerc "$exception_group" ExceptionType 0 || failed=true
        kde_check_value breezerc "$exception_group" HideTitleBar true || failed=true
        kde_check_value breezerc "$exception_group" Mask 0 || failed=true
    fi

    local rules
    rules="$(kreadconfig6 --file kwinrulesrc --group General --key rules)"
    if [[ ",$rules," != *',nulifyer-project-picker,'* ]]; then
        printf 'dotfiles: KWin project picker placement rule is missing\n' >&2
        failed=true
    fi

    if [[ ! -r "$state_root/kde-scheme" ]]; then
        printf 'dotfiles: generated KDE scheme state is missing\n' >&2
        failed=true
    else
        kde_check_color_scheme || failed=true
    fi

    [[ "$failed" == false ]]
}

check_kde_project_picker() {
    command -v qdbus6 >/dev/null 2>&1 || return 0
    qdbus6 org.kde.kglobalaccel >/dev/null 2>&1 || return 0

    local actions
    actions="$(
        qdbus6 --literal org.kde.kglobalaccel /kglobalaccel \
            org.kde.KGlobalAccel.allActionsForComponent \
            nulifyer-project-picker.desktop 2>/dev/null
    )" || true
    if [[ "$actions" != *'"_launch"'* ]]; then
        printf 'dotfiles: KDE project picker shortcut is not registered\n' >&2
        return 1
    fi

    local shortcut_info
    shortcut_info="$(
        qdbus6 --literal org.kde.kglobalaccel \
            /component/nulifyer_project_picker_desktop \
            org.kde.kglobalaccel.Component.allShortcutInfos 2>/dev/null
    )" || true
    local active_keys=''
    if [[ "$shortcut_info" =~ \[Argument:\ ai\ \{([^}]*)\}\] ]]; then
        active_keys=${BASH_REMATCH[1]}
    fi
    # 201326672 is Qt::CTRL | Qt::ALT | Qt::Key_P.
    if [[ "$active_keys" != 201326672 ]]; then
        printf 'dotfiles: KDE project picker shortcut is not Ctrl+Alt+P\n' >&2
        return 1
    fi
}

link_matches() {
    local source=$1
    local target=$2
    [[ -L "$target" ]] &&
        [[ "$(readlink -f -- "$target")" == "$(readlink -f -- "$source")" ]]
}

link_points_into_repository() {
    local target=$1
    [[ -L "$target" ]] || return 1
    local destination
    destination="$(readlink -m -- "$(dirname -- "$target")/$(readlink -- "$target")")"
    [[ "$destination" == "$DOTFILES_ROOT/"* ]]
}

deployment_rows() {
    jq -r '.deployments[] | [.name, .source, .target, .strategy] | @tsv' \
        "$LINK_CONFIG"
}

deployment_preserve_paths() {
    local name=$1
    jq -r --arg name "$name" \
        '.deployments[] | select(.name == $name) | .preserve[]?' \
        "$LINK_CONFIG"
}

deployment_target_root() {
    local target=$1
    if [[ "$target" == . ]]; then
        printf '%s\n' "$DOTFILES_TARGET"
    else
        printf '%s/%s\n' "$DOTFILES_TARGET" "$target"
    fi
}

path_is_safe_relative() {
    local value=$1
    [[ -n "$value" && "$value" != /* && "$value" != .. &&
        "$value" != ../* && "$value" != */.. && "$value" != */../* ]]
}

validate_link_config() {
    jq -e '
        (.deployments | type == "array" and length > 0) and
        ([.deployments[].name] | length == (unique | length)) and
        all(.deployments[];
            (.name | type == "string" and length > 0) and
            (.source | type == "string" and length > 0) and
            (.target | type == "string" and length > 0) and
            (.strategy == "file" or .strategy == "contents" or
                .strategy == "directory") and
            ((.preserve // []) | type == "array") and
            all((.preserve // [])[]; type == "string" and length > 0)
        )
    ' "$LINK_CONFIG" >/dev/null || {
        printf 'dotfiles: invalid deployment manifest: %s\n' \
            "$LINK_CONFIG" >&2
        return 1
    }

    local name source target strategy preserve
    while IFS=$'\t' read -r name source target strategy; do
        if ! path_is_safe_relative "$source" ||
            ! path_is_safe_relative "$target"; then
            printf 'dotfiles: unsafe deployment path for %s\n' "$name" >&2
            return 1
        fi
        if [[ "$strategy" == file &&
            ! -f "$DOTFILES_ROOT/$source" &&
            ! -L "$DOTFILES_ROOT/$source" ]]; then
            printf 'dotfiles: deployment source is missing: %s\n' \
                "$DOTFILES_ROOT/$source" >&2
            return 1
        elif [[ "$strategy" != file && ! -d "$DOTFILES_ROOT/$source" ]]; then
            printf 'dotfiles: deployment source is missing: %s\n' \
                "$DOTFILES_ROOT/$source" >&2
            return 1
        fi
        while IFS= read -r preserve; do
            if ! path_is_safe_relative "$preserve"; then
                printf 'dotfiles: unsafe preserve path for %s: %s\n' \
                    "$name" "$preserve" >&2
                return 1
            fi
        done < <(deployment_preserve_paths "$name")
    done < <(deployment_rows)
}

replace_link_conflicts() {
    local name source_root target_root strategy source relative target choice
    local failed=false
    local -a conflict_sources=()
    local -a conflict_targets=()
    local -a conflict_choices=()

    while IFS=$'\t' read -r name source_root target_root strategy; do
        [[ "$strategy" != directory ]] || continue
        if [[ "$strategy" == file ]]; then
            source="$DOTFILES_ROOT/$source_root"
            target="$(deployment_target_root "$target_root")"
            link_matches "$source" "$target" && continue
            if link_points_into_repository "$target"; then
                rm -f -- "$target"
                continue
            fi
            if [[ -d "$target" && ! -L "$target" ]]; then
                printf 'dotfiles: refusing to replace directory: %s\n' \
                    "$target" >&2
                failed=true
            elif [[ -e "$target" || -L "$target" ]]; then
                conflict_sources+=("$source")
                conflict_targets+=("$target")
            fi
            continue
        fi
        target_root="$(deployment_target_root "$target_root")"
        while IFS= read -r -d '' source; do
            relative="${source#"$DOTFILES_ROOT/$source_root/"}"
            target="$target_root/$relative"
            link_matches "$source" "$target" && continue
            if link_points_into_repository "$target"; then
                rm -f -- "$target"
                continue
            fi

            if [[ -d "$target" && ! -L "$target" ]]; then
                printf 'dotfiles: refusing to replace directory: %s\n' \
                    "$target" >&2
                failed=true
            elif [[ -e "$target" || -L "$target" ]]; then
                conflict_sources+=("$source")
                conflict_targets+=("$target")
            fi
        done < <(
            find "$DOTFILES_ROOT/$source_root" \
                \( -type f -o -type l \) -print0
        )
    done < <(deployment_rows)

    [[ "$failed" == false ]] || return 1

    local index
    for index in "${!conflict_targets[@]}"; do
        source="${conflict_sources[$index]}"
        target="${conflict_targets[$index]}"
        while true; do
            printf 'Conflict: %s\n' "$target"
            printf '  [r] Keep repository version: %s\n' "$source"
            printf '  [t] Keep target version and import it into the repository\n'
            printf '  [a] Abort\n'
            printf 'Choose [r/t/a]: '
            if ! IFS= read -r choice; then
                printf '\ndotfiles: no conflict choice received; aborting\n' >&2
                return 1
            fi
            case "${choice,,}" in
                r | repository)
                    conflict_choices+=(repository)
                    break
                    ;;
                t | target)
                    conflict_choices+=(target)
                    break
                    ;;
                a | abort | '')
                    printf 'dotfiles: linking aborted\n' >&2
                    return 1
                    ;;
                *)
                    printf 'Enter r, t, or a.\n' >&2
                    ;;
            esac
        done
    done

    for index in "${!conflict_targets[@]}"; do
        source="${conflict_sources[$index]}"
        target="${conflict_targets[$index]}"
        if [[ "${conflict_choices[$index]}" == repository ]]; then
            printf 'Keeping repository version: %s\n' "$source"
            rm -f -- "$target"
        else
            printf 'Importing target version into repository: %s\n' "$source"
            mv -fT -- "$target" "$source"
        fi
    done
}

path_is_preserved() {
    local relative=$1
    shift
    local preserve
    for preserve in "$@"; do
        if [[ "$relative" == "$preserve" ||
            "$relative" == "$preserve/"* ]]; then
            return 0
        fi
    done
    return 1
}

migrate_directory_target() {
    local name=$1
    local source=$2
    local target=$3
    local -a preserve_paths=()
    mapfile -t preserve_paths < <(deployment_preserve_paths "$name")

    local preserve source_path target_path
    for preserve in "${preserve_paths[@]}"; do
        source_path="$source/$preserve"
        target_path="$target/$preserve"
        if [[ -e "$target_path" || -L "$target_path" ]]; then
            if [[ -e "$source_path" || -L "$source_path" ]]; then
                printf 'dotfiles: cannot preserve %s; source already exists: %s\n' \
                    "$target_path" "$source_path" >&2
                return 1
            fi
        fi
    done

    local installed relative expected failed=false
    while IFS= read -r -d '' installed; do
        relative="${installed#"$target/"}"
        path_is_preserved "$relative" "${preserve_paths[@]}" && continue
        expected="$source/$relative"
        if [[ ! -f "$expected" && ! -L "$expected" ]]; then
            printf 'dotfiles: unmanaged file blocks directory deployment: %s\n' \
                "$installed" >&2
            failed=true
        elif ! link_matches "$expected" "$installed" &&
            ! { [[ -f "$installed" && ! -L "$installed" ]] &&
                cmp -s -- "$expected" "$installed"; }; then
            printf 'dotfiles: file differs before directory deployment: %s\n' \
                "$installed" >&2
            failed=true
        fi
    done < <(find "$target" \( -type f -o -type l \) -print0)
    [[ "$failed" == false ]] || return 1

    printf 'Migrating %s runtime state into %s...\n' "$name" "$source"
    for preserve in "${preserve_paths[@]}"; do
        source_path="$source/$preserve"
        target_path="$target/$preserve"
        if [[ -e "$target_path" || -L "$target_path" ]]; then
            mkdir -p -- "$(dirname -- "$source_path")"
            mv -- "$target_path" "$source_path"
        fi
    done

    while IFS= read -r -d '' installed; do
        relative="${installed#"$target/"}"
        path_is_preserved "$relative" "${preserve_paths[@]}" && continue
        rm -f -- "$installed"
    done < <(find "$target" \( -type f -o -type l \) -print0)

    local directory
    while IFS= read -r -d '' directory; do
        rmdir -- "$directory"
    done < <(find "$target" -depth -type d -print0)
}

deploy_contents() {
    local source_root=$1
    local target_root=$2
    local source relative target
    while IFS= read -r -d '' source; do
        relative="${source#"$source_root/"}"
        target="$target_root/$relative"
        link_matches "$source" "$target" && continue
        mkdir -p -- "$(dirname -- "$target")"
        ln -sr -- "$source" "$target"
    done < <(find "$source_root" \( -type f -o -type l \) -print0)
}

deploy_file() {
    local source=$1
    local target=$2
    link_matches "$source" "$target" && return
    mkdir -p -- "$(dirname -- "$target")"
    ln -sr -- "$source" "$target"
}

deploy_directory() {
    local name=$1
    local source=$2
    local target=$3
    link_matches "$source" "$target" && return

    if [[ -d "$target" && ! -L "$target" ]]; then
        migrate_directory_target "$name" "$source" "$target"
    elif link_points_into_repository "$target"; then
        local old_source preserve old_path new_path
        old_source="$(readlink -f -- "$target")"
        printf 'Relocating %s directory deployment to %s...\n' \
            "$name" "$source"
        while IFS= read -r preserve; do
            old_path="$old_source/$preserve"
            new_path="$source/$preserve"
            if [[ ! -e "$old_path" && ! -L "$old_path" ]]; then
                continue
            fi
            if [[ -e "$new_path" || -L "$new_path" ]]; then
                printf 'dotfiles: cannot relocate %s; destination exists: %s\n' \
                    "$old_path" "$new_path" >&2
                return 1
            fi
            mkdir -p -- "$(dirname -- "$new_path")"
            mv -- "$old_path" "$new_path"
        done < <(deployment_preserve_paths "$name")
        rm -f -- "$target"
    elif [[ -e "$target" || -L "$target" ]]; then
        printf 'dotfiles: target blocks directory deployment: %s\n' \
            "$target" >&2
        return 1
    fi

    mkdir -p -- "$(dirname -- "$target")"
    ln -sr -- "$source" "$target"
}

link_packages() {
    require_command jq
    require_generated_theme
    validate_link_config
    replace_link_conflicts
    printf 'Deploying dotfiles into %s...\n' "$DOTFILES_TARGET"

    local name source target strategy target_root
    while IFS=$'\t' read -r name source target strategy; do
        target_root="$(deployment_target_root "$target")"
        if [[ "$strategy" == file ]]; then
            deploy_file "$DOTFILES_ROOT/$source" "$target_root"
        elif [[ "$strategy" == contents ]]; then
            deploy_contents "$DOTFILES_ROOT/$source" "$target_root"
        else
            deploy_directory "$name" "$DOTFILES_ROOT/$source" "$target_root"
        fi
    done < <(deployment_rows)
}

unlink_packages() {
    require_command jq
    validate_link_config
    printf 'Removing managed links from %s...\n' "$DOTFILES_TARGET"

    local name source_root target strategy target_root source relative installed
    while IFS=$'\t' read -r name source_root target strategy; do
        target_root="$(deployment_target_root "$target")"
        if [[ "$strategy" == directory ]]; then
            if link_matches "$DOTFILES_ROOT/$source_root" "$target_root"; then
                rm -f -- "$target_root"
            fi
            continue
        elif [[ "$strategy" == file ]]; then
            if link_matches "$DOTFILES_ROOT/$source_root" "$target_root"; then
                rm -f -- "$target_root"
            fi
            continue
        fi
        while IFS= read -r -d '' source; do
            relative="${source#"$DOTFILES_ROOT/$source_root/"}"
            installed="$target_root/$relative"
            if link_matches "$source" "$installed"; then
                rm -f -- "$installed"
            fi
        done < <(
            find "$DOTFILES_ROOT/$source_root" \
                \( -type f -o -type l \) -print0
        )
    done < <(deployment_rows)
}

theme_current() {
    local current_file="$THEME_LOCAL_STATE/current"
    if [[ -r "$current_file" ]]; then
        local current
        IFS= read -r current <"$current_file"
        printf '%s\n' "$current"
    else
        printf '%s\n' gruvbox
    fi
}

require_generated_theme() {
    local current_file="$THEME_LOCAL_STATE/current"
    if [[ ! -r "$current_file" ]]; then
        printf 'dotfiles: local theme output is missing\n' >&2
        printf 'Run `./dotfiles theme NAME` before linking or checking.\n' >&2
        return 1
    fi

    local current
    current="$(theme_current)"
    "$THEME_RENDERER" --check "$DOTFILES_ROOT" "$current"
}

theme_list() {
    jq -r '
        to_entries[]
        | [.key, .value.name, .value.variant]
        | @tsv
    ' "$THEME_CATALOG"
}

theme_command() {
    require_command jq
    require_command python3

    if [[ "$#" -gt 1 ]]; then
        printf 'Usage: ./dotfiles theme [NAME|--list|--current|--reload]\n' >&2
        return 2
    fi

    local requested=${1-}
    case "$requested" in
        -h | --help)
            cat <<'EOF'
Usage: ./dotfiles theme [NAME|--list|--current|--reload]

With no name, choose a theme interactively with fzf.
  --list     List available themes
  --current  Print the tracked selected theme
  --reload   Regenerate the tracked selected theme
EOF
            return
            ;;
        --list)
            theme_list
            return
            ;;
        --current)
            theme_current
            return
            ;;
        --reload)
            requested="$(theme_current)"
            ;;
        '')
            require_command fzf
            local choice
            choice="$(
                theme_list |
                    fzf \
                        --height=60% \
                        --layout=reverse \
                        --border \
                        --delimiter=$'\t' \
                        --with-nth=2,3 \
                        --prompt='theme › ' \
                        --header='name / variant'
            )"
            [[ -n "$choice" ]] || return
            requested="${choice%%$'\t'*}"
            ;;
    esac

    if ! jq -e --arg name "$requested" 'has($name)' \
        "$THEME_CATALOG" >/dev/null; then
        printf 'dotfiles: unknown theme: %s\n' "$requested" >&2
        printf 'Run `./dotfiles theme --list` to see available names.\n' >&2
        return 2
    fi

    "$THEME_RENDERER" "$DOTFILES_ROOT" "$requested"

    local display
    display="$(
        jq -r --arg name "$requested" '.[$name].name' "$THEME_CATALOG"
    )"
    printf 'Generated local theme files for %s (%s).\n' \
        "$display" "$requested"

    local scheme_source
    local scheme_target
    local scheme
    IFS= read -r scheme <"$THEME_LOCAL_STATE/kde-scheme"
    scheme_source="$DOTFILES_ROOT/kde/$scheme.colors"
    scheme_target="$HOME/.local/share/color-schemes/$scheme.colors"
    if [[ "$DOTFILES_TARGET" == "$HOME" ]] &&
        link_matches "$scheme_source" "$scheme_target"; then
        apply_settings
    else
        printf 'Run `./dotfiles link` and `./dotfiles apply` to install it.\n'
    fi
}

apply_settings() {
    require_generated_theme
    if command -v kwriteconfig6 >/dev/null 2>&1; then
        apply_kde_settings
    else
        printf 'Skipping KDE settings: Plasma configuration tools are unavailable.\n'
    fi
    apply_brave_settings
}

check_json() {
    require_command jq

    local json_file
    local -a json_files=(
        "$THEME_CATALOG"
        "$LINK_CONFIG"
        "$DOTFILES_ROOT/.theme/vscode/package.json"
        "$DOTFILES_ROOT/.theme/vscode/workbench.json"
        "$DOTFILES_ROOT/.theme/vscode/tokens.json"
        "$DOTFILES_ROOT/.theme/vscode/semantic.json"
        "$DOTFILES_ROOT/vscode/extension/package.json"
        "$DOTFILES_ROOT/vscode/extension/themes/nulifyer.json"
        "$DOTFILES_ROOT/vscode/settings.json"
        "$DOTFILES_ROOT/opencode/themes/nulifyer.json"
    )

    for json_file in "${json_files[@]}"; do
        jq -e . "$json_file" >/dev/null
    done

    validate_link_config

    jq -e '
        length > 0 and
        all(.[]; (.variant == "dark" or .variant == "light") and
            (.prompt | keys | length) == 7 and
            (.terminal.normal | keys | length) == 8 and
            (.terminal.bright | keys | length) == 8)
    ' "$THEME_CATALOG" >/dev/null
    jq -e 'length == 422' \
        "$DOTFILES_ROOT/.theme/vscode/workbench.json" \
        >/dev/null
    jq -e 'length == 790' \
        "$DOTFILES_ROOT/.theme/vscode/tokens.json" \
        >/dev/null
    jq -e 'length == 62' \
        "$DOTFILES_ROOT/.theme/vscode/semantic.json" \
        >/dev/null

    "$THEME_RENDERER" --validate
}

check_shell() {
    bash -n \
        "$DOTFILES_ROOT/dotfiles" \
        "$DOTFILES_ROOT/bash/bashrc" \
        "$DOTFILES_ROOT/bash/bash_profile"

    fish -n \
        "$DOTFILES_ROOT/fish/config.fish" \
        "$DOTFILES_ROOT/fish/conf.d/"*.fish

    if command -v zsh >/dev/null 2>&1; then
        zsh -n "$DOTFILES_ROOT/zsh/zshrc"
    fi

    python3 -c '
import pathlib

for name in (
    "'"$THEME_RENDERER"'",
    "'"$DOTFILES_ROOT/.theme/check_kde.py"'",
):
    compile(pathlib.Path(name).read_text(), pathlib.Path(name).name, "exec")
'
}

check_desktop_entries() {
    local desktop_file="$DOTFILES_ROOT/applications/nulifyer-project-picker.desktop"
    grep -qx 'Type=Application' "$desktop_file"
    grep -qx 'Exec=kitty --class nulifyer-project-picker --title "Project Picker" --override remember_window_size=no --override initial_window_width=72c --override initial_window_height=13c fish -c zpick' \
        "$desktop_file"
    grep -qx 'X-KDE-Shortcuts=Ctrl+Alt+P' "$desktop_file"

    if command -v desktop-file-validate >/dev/null 2>&1; then
        desktop-file-validate "$desktop_file"
    fi
}

check_toml() {
    python3 -c '
import pathlib
import tomllib

for name in (
    "'"$DOTFILES_ROOT/alacritty/alacritty.toml"'",
    "'"$DOTFILES_ROOT/alacritty/theme.generated.toml"'",
):
    with pathlib.Path(name).open("rb") as stream:
        tomllib.load(stream)
'
}

check_package_manifest() {
    local class package extra
    local failed=false
    local -A seen=()

    while read -r class package extra; do
        [[ -n "${class:-}" ]] || continue
        [[ "$class" == \#* ]] && continue

        if [[ "$class" != required && "$class" != managed &&
            "$class" != optional ]]; then
            printf 'dotfiles: invalid package class: %s\n' "$class" >&2
            failed=true
        fi
        if [[ -z "${package:-}" || -n "${extra:-}" ||
            ! "$package" =~ ^[a-zA-Z0-9@._+-]+$ ]]; then
            printf 'dotfiles: invalid Arch package entry: %s %s %s\n' \
                "$class" "${package:-}" "${extra:-}" >&2
            failed=true
        elif [[ -n "${seen[$package]:-}" ]]; then
            printf 'dotfiles: duplicate Arch package: %s\n' "$package" >&2
            failed=true
        else
            seen[$package]=1
        fi
    done <"$DOTFILES_ROOT/packages.arch"

    [[ "$failed" == false ]]
}

check_deployment_layout() {
    local directory package name source target strategy
    local -A expected_packages=()

    while IFS=$'\t' read -r name source target strategy; do
        expected_packages["${source%%/*}"]=1
    done < <(deployment_rows)

    for directory in "$DOTFILES_ROOT"/*/; do
        package="${directory%/}"
        package="${package##*/}"
        if [[ -z "${expected_packages[$package]:-}" ]]; then
            printf 'dotfiles: visible directory has no deployment: %s\n' \
                "$package" >&2
            return 1
        fi
    done
}

check_generated_theme() {
    require_generated_theme
}

check_links() {
    local failed=false
    local name source_root target strategy target_root source relative installed
    local -A expected_targets=()
    local -A target_directories=()

    while IFS=$'\t' read -r name source_root target strategy; do
        target_root="$(deployment_target_root "$target")"
        if [[ "$strategy" == directory ]]; then
            expected_targets["$target_root"]=1
            target_directories["$(dirname -- "$target_root")"]=1
            if ! link_matches "$DOTFILES_ROOT/$source_root" "$target_root"; then
                printf 'dotfiles: directory-link drift: %s -> %s\n' \
                    "$target_root" "$DOTFILES_ROOT/$source_root" >&2
                failed=true
            fi
            continue
        elif [[ "$strategy" == file ]]; then
            expected_targets["$target_root"]=1
            target_directories["$(dirname -- "$target_root")"]=1
            if ! link_matches "$DOTFILES_ROOT/$source_root" "$target_root"; then
                printf 'dotfiles: link drift: %s -> %s\n' \
                    "$target_root" "$DOTFILES_ROOT/$source_root" >&2
                failed=true
            fi
            continue
        fi

        while IFS= read -r -d '' source; do
            relative="${source#"$DOTFILES_ROOT/$source_root/"}"
            installed="$target_root/$relative"
            expected_targets["$installed"]=1
            target_directories["$(dirname -- "$installed")"]=1
            if ! link_matches "$source" "$installed"; then
                printf 'dotfiles: link drift: %s -> %s\n' \
                    "$installed" "$source" >&2
                failed=true
            fi
        done < <(
            find "$DOTFILES_ROOT/$source_root" \
                \( -type f -o -type l \) -print0
        )
    done < <(deployment_rows)

    local directory installed_link
    local raw_destination resolved_destination
    for directory in "${!target_directories[@]}"; do
        [[ -d "$directory" ]] || continue
        while IFS= read -r -d '' installed_link; do
            [[ -n "${expected_targets[$installed_link]:-}" ]] && continue
            raw_destination="$(readlink -- "$installed_link")"
            if [[ "$raw_destination" == /* ]]; then
                resolved_destination="$(readlink -m -- "$raw_destination")"
            else
                resolved_destination="$(
                    readlink -m -- "$directory/$raw_destination"
                )"
            fi
            if [[ "$resolved_destination" == "$DOTFILES_ROOT/"* ]]; then
                printf 'dotfiles: obsolete managed link: %s -> %s\n' \
                    "$installed_link" "$raw_destination" >&2
                failed=true
            fi
        done < <(find "$directory" -maxdepth 1 -type l -print0)
    done

    [[ "$failed" == false ]]
}

check_active_settings() {
    local target_root
    local home_root
    target_root="$(readlink -f -- "$DOTFILES_TARGET")"
    home_root="$(readlink -f -- "$HOME")"
    if [[ "$target_root" != "$home_root" ]]; then
        return
    fi

    if command -v code >/dev/null 2>&1; then
        code --list-extensions --show-versions 2>/dev/null |
            grep -q '^nulifyer\.nulifyer-theme@1\.2\.0$'
        local workbench_version current_workbench
        current_workbench="$(readlink -f -- "$HOME/.local/lib/opencode-workbench/current" 2>/dev/null || true)"
        workbench_version="${current_workbench##*/}"
        [[ "$workbench_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
        code --list-extensions --show-versions 2>/dev/null |
            grep -q "^opencode-workbench\.opencode-workbench-vscode@$workbench_version\$"
    fi

    local brave_preferences="$HOME/.config/BraveSoftware/Brave-Browser/Default/Preferences"
    if [[ -f "$brave_preferences" ]]; then
        jq -e '.browser.custom_chrome_frame == false' \
            "$brave_preferences" >/dev/null
    fi

    check_kde_settings
    check_kde_project_picker
}

check_all() {
    printf 'Validating dotfiles...\n'
    git -C "$DOTFILES_ROOT" diff --check HEAD
    check_generated_theme
    check_json
    check_shell
    check_desktop_entries
    check_toml
    check_package_manifest
    check_deployment_layout
    check_links
    check_active_settings
    printf 'All local checks passed.\n'
}

show_status() {
    printf 'Repository: %s\n' "$DOTFILES_ROOT"
    printf 'Target:     %s\n' "$DOTFILES_TARGET"
    printf 'Deployments: %s\n' \
        "$(jq -r '[.deployments[].name] | join(" ")' "$LINK_CONFIG")"
    printf '\nGit status:\n'
    git -C "$DOTFILES_ROOT" status --short
    printf '\nConfigured MCP servers:\n'
    if command -v codex >/dev/null 2>&1; then
        codex mcp list
    else
        printf 'Codex is not installed.\n'
    fi
}

version_at_least() {
    [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n1)" == "$2" ]]
}

workbench_channel() {
    local channel
    IFS= read -r channel <"$DOTFILES_ROOT/opencode-workbench/channel"
    if [[ "$channel" != stable ]]; then
        printf 'dotfiles: unsupported OpenCode Workbench channel: %s\n' "$channel" >&2
        return 1
    fi
    printf '%s\n' "$channel"
}

workbench_latest_version() {
    workbench_channel >/dev/null
    curl --fail --silent --show-error \
        'https://api.github.com/repos/nulifyer/opencode-workbench/releases/latest' |
        jq -er '.tag_name | select(test("^v[0-9]+\\.[0-9]+\\.[0-9]+$")) | ltrimstr("v")'
}

workbench_prepare_environment() {
    local environment_root="$HOME/.config/opencode-workbench"
    local environment_file="$environment_root/server.env"
    mkdir -p -- "$environment_root"
    chmod 0700 -- "$environment_root"
    if [[ ! -e "$environment_file" && ! -L "$environment_file" ]]; then
        local temporary password
        temporary="$environment_root/.server.env-$RANDOM"
        password="$(python3 -c 'import secrets; print(secrets.token_hex(32))')"
        (umask 077 && printf 'OPENCODE_SERVER_USERNAME=opencode\nOPENCODE_SERVER_PASSWORD=%s\n' "$password" >"$temporary")
        mv -T -- "$temporary" "$environment_file"
    fi
    if [[ ! -f "$environment_file" || -L "$environment_file" ||
        "$(stat -c %u -- "$environment_file")" != "$(id -u)" ||
        "$(stat -c %a -- "$environment_file")" != 600 ]]; then
        printf 'dotfiles: server environment must be an owner-only regular file: %s\n' "$environment_file" >&2
        return 1
    fi
    grep -Eq '^OPENCODE_SERVER_USERNAME=opencode$' "$environment_file"
    grep -Eq '^OPENCODE_SERVER_PASSWORD=[0-9a-f]{64}$' "$environment_file"
}

workbench_health_check() (
    set -euo pipefail
    local environment_file="$HOME/.config/opencode-workbench/server.env"
    local username password netrc response
    username="$(grep '^OPENCODE_SERVER_USERNAME=' "$environment_file" | cut -d= -f2-)"
    password="$(grep '^OPENCODE_SERVER_PASSWORD=' "$environment_file" | cut -d= -f2-)"
    netrc="$(mktemp)"
    trap 'rm -f -- "$netrc"' EXIT
    chmod 0600 -- "$netrc"
    printf 'machine 127.0.0.1 login %s password %s\n' "$username" "$password" >"$netrc"
    if ! response="$(curl --fail --silent --retry 10 --retry-all-errors \
        --retry-delay 1 --netrc-file "$netrc" --get \
        --data-urlencode "directory=$HOME" "http://127.0.0.1:4096/session")"; then
        printf 'dotfiles: OpenCode Workbench server health request failed\n' >&2
        return 1
    fi
    jq -e 'type == "array"' <<<"$response" >/dev/null
)

workbench_verify_local_release() {
    local version=$1
    local version_root="$HOME/.local/lib/opencode-workbench/$version"
    [[ -d "$version_root" && ! -L "$version_root" ]] || return 1
    local asset
    for asset in opencode-plugin.js \
        "opencode-workbench-vscode-$version.vsix" release.json SHA256SUMS; do
        [[ -f "$version_root/$asset" && ! -L "$version_root/$asset" ]] || return 1
        gh attestation verify "$version_root/$asset" \
            --repo Nulifyer/opencode-workbench \
            --signer-workflow Nulifyer/opencode-workbench/.github/workflows/release.yml \
            --source-ref "refs/tags/v$version" --deny-self-hosted-runners >/dev/null || return
    done
    (
        cd -- "$version_root"
        sha256sum --check SHA256SUMS
    ) || return
}

workbench_switch_local() {
    local version=$1
    local install_root="$HOME/.local/lib/opencode-workbench"
    local version_root="$install_root/$version"
    local current_link="$install_root/current"
    local temporary_link="$install_root/.current-$RANDOM"
    workbench_verify_local_release "$version" || return
    if [[ -e "$current_link" && ! -L "$current_link" ]]; then
        printf 'dotfiles: refusing to replace non-link path: %s\n' "$current_link" >&2
        return 1
    fi
    code --install-extension \
        "$version_root/opencode-workbench-vscode-$version.vsix" --force || return
    ln -s -- "$version" "$temporary_link" || return
    mv -Tf -- "$temporary_link" "$current_link" || return
    systemctl --user daemon-reload || return
    systemctl --user enable --now opencode-workbench.service || return
    systemctl --user restart opencode-workbench.service || return
    workbench_health_check || return
}

workbench_install() (
    set -euo pipefail
    require_command code
    require_command curl
    require_command gh
    require_command jq
    require_command python3
    require_command sha256sum
    require_command systemctl

    local version="${1:-}"
    if [[ -z "$version" ]]; then
        version="$(workbench_latest_version)"
    elif [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        printf 'dotfiles: invalid OpenCode Workbench version: %s\n' "$version" >&2
        return 2
    fi
    local release_url temporary
    release_url="https://github.com/nulifyer/opencode-workbench/releases/download/v$version"
    temporary="$(mktemp -d)"
    trap 'rm -rf -- "$temporary"' EXIT

    local asset
    for asset in opencode-plugin.js \
        "opencode-workbench-vscode-$version.vsix" release.json SHA256SUMS; do
        curl --fail --location --silent --show-error \
            --output "$temporary/$asset" "$release_url/$asset"
        gh attestation verify "$temporary/$asset" \
            --repo Nulifyer/opencode-workbench \
            --signer-workflow Nulifyer/opencode-workbench/.github/workflows/release.yml \
            --source-ref "refs/tags/v$version" --deny-self-hosted-runners >/dev/null
    done
    jq -e --arg version "$version" '
        .schemaVersion == 1 and .version == $version and
        .protocolVersion == 1 and
        (.compatibility.minimumOpenCode | test("^[0-9]+\\.[0-9]+\\.[0-9]+$")) and
        (.compatibility.maximumOpenCodeExclusive | test("^[0-9]+\\.[0-9]+\\.[0-9]+$")) and
        (.compatibility.minimumVSCode | test("^[0-9]+\\.[0-9]+\\.[0-9]+$")) and
        ([.assets[].name] | sort) ==
          (["opencode-plugin.js", "opencode-workbench-vscode-" + $version + ".vsix"] | sort)
    ' "$temporary/release.json" >/dev/null
    (
        cd -- "$temporary"
        sha256sum --check SHA256SUMS
    )
    local opencode_version vscode_version minimum_opencode maximum_opencode minimum_vscode
    opencode_version="$(opencode --version | grep -Eo '[0-9]+\.[0-9]+\.[0-9]+' | head -n1)"
    vscode_version="$(code --version | head -n1)"
    minimum_opencode="$(jq -r '.compatibility.minimumOpenCode' "$temporary/release.json")"
    maximum_opencode="$(jq -r '.compatibility.maximumOpenCodeExclusive' "$temporary/release.json")"
    minimum_vscode="$(jq -r '.compatibility.minimumVSCode' "$temporary/release.json")"
    version_at_least "$opencode_version" "$minimum_opencode" || {
        printf 'dotfiles: OpenCode %s is older than required %s\n' "$opencode_version" "$minimum_opencode" >&2
        return 1
    }
    if version_at_least "$opencode_version" "$maximum_opencode"; then
        printf 'dotfiles: OpenCode %s is newer than supported range ending at %s\n' "$opencode_version" "$maximum_opencode" >&2
        return 1
    fi
    version_at_least "$vscode_version" "$minimum_vscode" || {
        printf 'dotfiles: VS Code %s is older than required %s\n' "$vscode_version" "$minimum_vscode" >&2
        return 1
    }

    local install_root version_root current_link previous_version
    install_root="$HOME/.local/lib/opencode-workbench"
    version_root="$install_root/$version"
    current_link="$install_root/current"
    previous_version="$(basename -- "$(readlink -f -- "$current_link" 2>/dev/null || true)")"
    mkdir -p -- "$version_root"
    install -m 0644 -- "$temporary/opencode-plugin.js" \
        "$version_root/opencode-plugin.js"
    install -m 0644 -- "$temporary/opencode-workbench-vscode-$version.vsix" \
        "$version_root/opencode-workbench-vscode-$version.vsix"
    install -m 0644 -- "$temporary/release.json" "$version_root/release.json"
    install -m 0644 -- "$temporary/SHA256SUMS" "$version_root/SHA256SUMS"
    workbench_prepare_environment
    if ! workbench_switch_local "$version"; then
        printf 'dotfiles: Workbench %s failed health check; rolling back\n' "$version" >&2
        if [[ "$previous_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            workbench_switch_local "$previous_version"
        else
            unlink -- "$current_link" 2>/dev/null || true
            systemctl --user stop opencode-workbench.service || true
        fi
        return 1
    fi

    printf 'Installed OpenCode Workbench %s.\n' "$version"
)

workbench_rollback() {
    local version=${1:-}
    if [[ ! "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        printf 'Usage: ./dotfiles workbench rollback VERSION\n' >&2
        return 2
    fi
    require_command code
    require_command gh
    require_command jq
    require_command sha256sum
    require_command systemctl
    workbench_prepare_environment
    local current previous_version
    current="$(readlink -f -- "$HOME/.local/lib/opencode-workbench/current" 2>/dev/null || true)"
    previous_version="${current##*/}"
    if ! workbench_switch_local "$version"; then
        printf 'dotfiles: rollback to %s failed health check; restoring %s\n' "$version" "$previous_version" >&2
        if [[ "$previous_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            workbench_switch_local "$previous_version"
        fi
        return 1
    fi
    printf 'Rolled back OpenCode Workbench to %s.\n' "$version"
}

workbench_status() {
    local channel current
    channel="$(workbench_channel)"
    current="$(readlink -f -- "$HOME/.local/lib/opencode-workbench/current" 2>/dev/null || true)"
    printf 'Release channel:   %s\n' "$channel"
    printf 'Installed plugin:  %s\n' "${current:-not installed}"
    if command -v code >/dev/null 2>&1; then
        printf 'VS Code extension: '
        code --list-extensions --show-versions 2>/dev/null |
            grep '^opencode-workbench\.opencode-workbench-vscode@' ||
            printf 'not installed\n'
    fi
    if command -v systemctl >/dev/null 2>&1; then
        printf 'Server service:    '
        systemctl --user is-active opencode-workbench.service 2>/dev/null || true
    fi
}

workbench_command() {
    case "${1:-install}" in
        install | update)
            [[ "$#" -le 2 ]] || return 2
            workbench_install "${2:-}"
            ;;
        rollback)
            [[ "$#" -eq 2 ]] || return 2
            workbench_rollback "$2"
            ;;
        status)
            [[ "$#" -eq 1 ]] || return 2
            workbench_status
            ;;
        *)
            printf 'Usage: ./dotfiles workbench [install|update [VERSION]|rollback VERSION|status]\n' >&2
            return 2
            ;;
    esac
}

update_all() {
    git -C "$DOTFILES_ROOT" pull --ff-only
    theme_command --reload
    link_packages
    if [[ -L "$HOME/.local/lib/opencode-workbench/current" ]]; then
        workbench_install
    fi
    apply_settings
    check_all
}

main() {
    local command_name="${1:-help}"

    if [[ "$command_name" != theme && "$command_name" != doctor &&
        "$command_name" != workbench &&
        "$#" -gt 1 ]]; then
        printf 'dotfiles: unexpected argument: %s\n' "$2" >&2
        usage >&2
        return 2
    fi

    case "$command_name" in
        link)
            link_packages
            ;;
        apply)
            apply_settings
            ;;
        theme)
            theme_command "${@:2}"
            ;;
        check)
            check_all
            ;;
        doctor)
            doctor_command "${@:2}"
            ;;
        workbench)
            workbench_command "${@:2}"
            ;;
        update)
            update_all
            ;;
        status)
            show_status
            ;;
        unlink)
            unlink_packages
            ;;
        help | -h | --help)
            usage
            ;;
        *)
            printf 'dotfiles: unknown command: %s\n' "$command_name" >&2
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
