#!/usr/bin/env bash

set -euo pipefail

DOTFILES_SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly DOTFILES_SCRIPT_PATH
DOTFILES_ROOT="$(
    cd -- "$(dirname -- "$DOTFILES_SCRIPT_PATH")"
    pwd -P
)"
readonly DOTFILES_ROOT
readonly DOTFILES_TARGET="${DOTFILES_TARGET:-$HOME}"
readonly MODULE_RUNNER="$DOTFILES_ROOT/.dotfiles/modules.py"
readonly THEME_CATALOG="$DOTFILES_ROOT/colors.json"
readonly THEME_RENDERER="$DOTFILES_ROOT/.theme/render.py"
readonly THEME_LOCAL_STATE="$DOTFILES_ROOT/.theme/local"
usage() {
    cat <<'EOF'
Usage: ./dotfiles COMMAND

Commands:
  link         Deploy app-owned files by link or copy
  apply        Apply settings that cannot safely be linked
  theme        Generate local theme files from colors.json
  check        Validate source files, generated files, and installed links
  doctor       Report required and optional setup dependencies
  update       Pull with --ff-only, then link, apply, and validate
  status       Show repository and package status
  unlink       Remove unchanged deployed files
  help         Show this help

Environment:
  DOTFILES_TARGET  Override the deployment target (default: $HOME)
EOF
}

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'dotfiles: required command not found: %s\n' "$1" >&2
        exit 1
    fi
}

doctor_command() {
    local strict=false
    if [[ "${1-}" == --strict ]]; then
        strict=true
        shift
    fi
    if [[ "$#" -ne 0 ]]; then
        printf 'Usage: ./dotfiles doctor [--strict]\n' >&2
        return 2
    fi

    local missing_required=false
    local missing_any=false
    local class dependency owners

    printf 'Commands:\n'
    while IFS=$'\t' read -r class dependency owners; do
        if command -v "$dependency" >/dev/null 2>&1; then
            printf '  ok       %-8s %-28s %s\n' "$class" "$dependency" "$owners"
        else
            printf '  missing  %-8s %-28s %s\n' \
                "$class" "$dependency" "$owners"
            missing_any=true
            [[ "$class" == required ]] && missing_required=true
        fi
    done < <(
        python3 "$MODULE_RUNNER" --root "$DOTFILES_ROOT" \
            dependencies commands
    )

    if command -v pacman >/dev/null 2>&1; then
        printf '\nArch packages:\n'
        while IFS=$'\t' read -r class dependency owners; do
            if pacman -T "$dependency" >/dev/null 2>&1; then
                printf '  ok       %-8s %-28s %s\n' \
                    "$class" "$dependency" "$owners"
            else
                printf '  missing  %-8s %-28s %s\n' \
                    "$class" "$dependency" "$owners"
                missing_any=true
                [[ "$class" == required ]] && missing_required=true
            fi
        done < <(
            python3 "$MODULE_RUNNER" --root "$DOTFILES_ROOT" \
                dependencies packages --platform arch
        )
    else
        printf '\nArch package checks skipped: pacman is unavailable.\n'
    fi

    if [[ "$missing_required" == true ]] ||
        [[ "$strict" == true && "$missing_any" == true ]]; then
        return 1
    fi
}

link_matches() {
    local source=$1
    local target=$2
    [[ -L "$target" ]] &&
        [[ "$(readlink -f -- "$target")" == "$(readlink -f -- "$source")" ]]
}

link_points_into_repository() {
    local target=$1
    [[ -L "$target" ]] || return 1
    local destination
    destination="$(readlink -m -- "$(dirname -- "$target")/$(readlink -- "$target")")"
    [[ "$destination" == "$DOTFILES_ROOT/"* ]]
}

deployment_rows() {
    python3 "$MODULE_RUNNER" --root "$DOTFILES_ROOT" rows
}

all_deployment_rows() {
    python3 "$MODULE_RUNNER" --root "$DOTFILES_ROOT" rows --all
}

deployment_preserve_paths() {
    python3 "$MODULE_RUNNER" --root "$DOTFILES_ROOT" preserve "$1"
}

deployment_source_files() {
    python3 "$MODULE_RUNNER" --root "$DOTFILES_ROOT" files "$1"
}

deployment_target_root() {
    local target=$1
    if [[ "$target" == . ]]; then
        printf '%s\n' "$DOTFILES_TARGET"
    else
        printf '%s/%s\n' "$DOTFILES_TARGET" "$target"
    fi
}

validate_deployments() {
    python3 "$MODULE_RUNNER" --root "$DOTFILES_ROOT" validate
}

run_module_hooks() {
    local action=$1
    local include_inactive=${2:-false}
    local -a arguments=(
        "$MODULE_RUNNER" --root "$DOTFILES_ROOT" hooks "$action"
    )
    if [[ "$include_inactive" == true ]]; then
        arguments+=(--all)
    fi

    local module hook
    local failed=false
    while IFS=$'\t' read -r module hook; do
        printf '%s %s settings...\n' "${action^}" "$module"
        if ! env \
            DOTFILES_ROOT="$DOTFILES_ROOT" \
            DOTFILES_TARGET="$DOTFILES_TARGET" \
            DOTFILES_MODULE="$module" \
            bash "$hook"; then
            failed=true
        fi
    done < <(python3 "${arguments[@]}")
    [[ "$failed" == false ]]
}

deployment_matches() {
    local source=$1
    local target=$2
    local install_method=$3
    if [[ "$install_method" == link ]]; then
        link_matches "$source" "$target"
    else
        [[ -f "$target" && ! -L "$target" ]] && cmp -s -- "$source" "$target"
    fi
}

replace_link_conflicts() {
    local name source_root target_root source_kind install_method module
    local source relative target choice
    local failed=false
    local -a conflict_sources=()
    local -a conflict_targets=()
    local -a conflict_choices=()

    while IFS=$'\t' read -r name source_root target_root source_kind install_method module; do
        [[ "$source_kind" != directory ]] || continue
        if [[ "$source_kind" == file ]]; then
            source="$DOTFILES_ROOT/$source_root"
            target="$(deployment_target_root "$target_root")"
            deployment_matches "$source" "$target" "$install_method" && continue
            if link_points_into_repository "$target"; then
                rm -f -- "$target"
                continue
            fi
            if [[ -d "$target" && ! -L "$target" ]]; then
                printf 'dotfiles: refusing to replace directory: %s\n' \
                    "$target" >&2
                failed=true
            elif [[ -e "$target" || -L "$target" ]]; then
                conflict_sources+=("$source")
                conflict_targets+=("$target")
            fi
            continue
        fi
        target_root="$(deployment_target_root "$target_root")"
        while IFS= read -r -d '' source; do
            source="$DOTFILES_ROOT/$source"
            relative="${source#"$DOTFILES_ROOT/$source_root/"}"
            target="$target_root/$relative"
            deployment_matches "$source" "$target" "$install_method" && continue
            if link_points_into_repository "$target"; then
                rm -f -- "$target"
                continue
            fi

            if [[ -d "$target" && ! -L "$target" ]]; then
                printf 'dotfiles: refusing to replace directory: %s\n' \
                    "$target" >&2
                failed=true
            elif [[ -e "$target" || -L "$target" ]]; then
                conflict_sources+=("$source")
                conflict_targets+=("$target")
            fi
        done < <(deployment_source_files "$name")
    done < <(deployment_rows)

    [[ "$failed" == false ]] || return 1

    local index
    for index in "${!conflict_targets[@]}"; do
        source="${conflict_sources[$index]}"
        target="${conflict_targets[$index]}"
        while true; do
            printf 'Conflict: %s\n' "$target"
            printf '  [r] Keep repository version: %s\n' "$source"
            printf '  [t] Keep target version and import it into the repository\n'
            printf '  [a] Abort\n'
            printf 'Choose [r/t/a]: '
            if ! IFS= read -r choice; then
                printf '\ndotfiles: no conflict choice received; aborting\n' >&2
                return 1
            fi
            case "${choice,,}" in
                r | repository)
                    conflict_choices+=(repository)
                    break
                    ;;
                t | target)
                    conflict_choices+=(target)
                    break
                    ;;
                a | abort | '')
                    printf 'dotfiles: linking aborted\n' >&2
                    return 1
                    ;;
                *)
                    printf 'Enter r, t, or a.\n' >&2
                    ;;
            esac
        done
    done

    for index in "${!conflict_targets[@]}"; do
        source="${conflict_sources[$index]}"
        target="${conflict_targets[$index]}"
        if [[ "${conflict_choices[$index]}" == repository ]]; then
            printf 'Keeping repository version: %s\n' "$source"
            rm -f -- "$target"
        else
            printf 'Importing target version into repository: %s\n' "$source"
            mv -fT -- "$target" "$source"
        fi
    done
}

path_is_preserved() {
    local relative=$1
    shift
    local preserve
    for preserve in "$@"; do
        if [[ "$relative" == "$preserve" ||
            "$relative" == "$preserve/"* ]]; then
            return 0
        fi
    done
    return 1
}

migrate_directory_target() {
    local name=$1
    local source=$2
    local target=$3
    local -a preserve_paths=()
    mapfile -t preserve_paths < <(deployment_preserve_paths "$name")

    local preserve source_path target_path
    for preserve in "${preserve_paths[@]}"; do
        source_path="$source/$preserve"
        target_path="$target/$preserve"
        if [[ -e "$target_path" || -L "$target_path" ]]; then
            if [[ -e "$source_path" || -L "$source_path" ]]; then
                printf 'dotfiles: cannot preserve %s; source already exists: %s\n' \
                    "$target_path" "$source_path" >&2
                return 1
            fi
        fi
    done

    local installed relative expected failed=false
    while IFS= read -r -d '' installed; do
        relative="${installed#"$target/"}"
        path_is_preserved "$relative" "${preserve_paths[@]}" && continue
        expected="$source/$relative"
        if [[ ! -f "$expected" && ! -L "$expected" ]]; then
            printf 'dotfiles: unmanaged file blocks directory deployment: %s\n' \
                "$installed" >&2
            failed=true
        elif ! link_matches "$expected" "$installed" &&
            ! { [[ -f "$installed" && ! -L "$installed" ]] &&
                cmp -s -- "$expected" "$installed"; }; then
            printf 'dotfiles: file differs before directory deployment: %s\n' \
                "$installed" >&2
            failed=true
        fi
    done < <(find "$target" \( -type f -o -type l \) -print0)
    [[ "$failed" == false ]] || return 1

    printf 'Migrating %s runtime state into %s...\n' "$name" "$source"
    for preserve in "${preserve_paths[@]}"; do
        source_path="$source/$preserve"
        target_path="$target/$preserve"
        if [[ -e "$target_path" || -L "$target_path" ]]; then
            mkdir -p -- "$(dirname -- "$source_path")"
            mv -- "$target_path" "$source_path"
        fi
    done

    while IFS= read -r -d '' installed; do
        relative="${installed#"$target/"}"
        path_is_preserved "$relative" "${preserve_paths[@]}" && continue
        rm -f -- "$installed"
    done < <(find "$target" \( -type f -o -type l \) -print0)

    local directory
    while IFS= read -r -d '' directory; do
        rmdir -- "$directory"
    done < <(find "$target" -depth -type d -print0)
}

deploy_contents() {
    local name=$1
    local source_root=$2
    local target_root=$3
    local install_method=$4
    local source relative target
    while IFS= read -r -d '' source; do
        source="$DOTFILES_ROOT/$source"
        relative="${source#"$source_root/"}"
        target="$target_root/$relative"
        deploy_file "$source" "$target" "$install_method"
    done < <(deployment_source_files "$name")
}

deploy_file() {
    local source=$1
    local target=$2
    local install_method=$3
    deployment_matches "$source" "$target" "$install_method" && return
    mkdir -p -- "$(dirname -- "$target")"
    if [[ "$install_method" == link ]]; then
        ln -sr -- "$source" "$target"
        return
    fi

    local temporary
    temporary="$(mktemp "$(dirname -- "$target")/.dotfiles-copy.XXXXXX")"
    if ! cp --preserve=mode --reflink=auto -- "$source" "$temporary"; then
        rm -f -- "$temporary"
        return 1
    fi
    mv -fT -- "$temporary" "$target"
}

deploy_directory() {
    local name=$1
    local source=$2
    local target=$3
    link_matches "$source" "$target" && return

    if [[ -d "$target" && ! -L "$target" ]]; then
        migrate_directory_target "$name" "$source" "$target"
    elif link_points_into_repository "$target"; then
        local old_source preserve old_path new_path
        old_source="$(readlink -f -- "$target")"
        printf 'Relocating %s directory deployment to %s...\n' \
            "$name" "$source"
        while IFS= read -r preserve; do
            old_path="$old_source/$preserve"
            new_path="$source/$preserve"
            if [[ ! -e "$old_path" && ! -L "$old_path" ]]; then
                continue
            fi
            if [[ -e "$new_path" || -L "$new_path" ]]; then
                printf 'dotfiles: cannot relocate %s; destination exists: %s\n' \
                    "$old_path" "$new_path" >&2
                return 1
            fi
            mkdir -p -- "$(dirname -- "$new_path")"
            mv -- "$old_path" "$new_path"
        done < <(deployment_preserve_paths "$name")
        rm -f -- "$target"
    elif [[ -e "$target" || -L "$target" ]]; then
        printf 'dotfiles: target blocks directory deployment: %s\n' \
            "$target" >&2
        return 1
    fi

    mkdir -p -- "$(dirname -- "$target")"
    ln -sr -- "$source" "$target"
}

link_packages() {
    require_command python3
    require_generated_theme
    validate_deployments
    replace_link_conflicts
    printf 'Deploying dotfiles into %s...\n' "$DOTFILES_TARGET"

    local name source target source_kind install_method module target_root
    while IFS=$'\t' read -r name source target source_kind install_method module; do
        target_root="$(deployment_target_root "$target")"
        if [[ "$source_kind" == file ]]; then
            deploy_file "$DOTFILES_ROOT/$source" "$target_root" "$install_method"
        elif [[ "$source_kind" == contents ]]; then
            deploy_contents \
                "$name" "$DOTFILES_ROOT/$source" "$target_root" "$install_method"
        else
            deploy_directory "$name" "$DOTFILES_ROOT/$source" "$target_root"
        fi
    done < <(deployment_rows)
}

unlink_packages() {
    require_command python3
    validate_deployments
    printf 'Removing unchanged managed files from %s...\n' "$DOTFILES_TARGET"

    local name source_root target source_kind install_method module
    local target_root source relative installed
    while IFS=$'\t' read -r name source_root target source_kind install_method module; do
        target_root="$(deployment_target_root "$target")"
        if [[ "$source_kind" == directory ]]; then
            if link_matches "$DOTFILES_ROOT/$source_root" "$target_root"; then
                rm -f -- "$target_root"
            fi
            continue
        elif [[ "$source_kind" == file ]]; then
            if deployment_matches \
                "$DOTFILES_ROOT/$source_root" "$target_root" "$install_method"; then
                rm -f -- "$target_root"
            fi
            continue
        fi
        while IFS= read -r -d '' source; do
            source="$DOTFILES_ROOT/$source"
            relative="${source#"$DOTFILES_ROOT/$source_root/"}"
            installed="$target_root/$relative"
            if deployment_matches "$source" "$installed" "$install_method"; then
                rm -f -- "$installed"
            fi
        done < <(deployment_source_files "$name")
    done < <(all_deployment_rows)
}

theme_current() {
    local current_file="$THEME_LOCAL_STATE/current"
    if [[ -r "$current_file" ]]; then
        local current
        IFS= read -r current <"$current_file"
        printf '%s\n' "$current"
    else
        printf '%s\n' gruvbox
    fi
}

require_generated_theme() {
    local current_file="$THEME_LOCAL_STATE/current"
    if [[ ! -r "$current_file" ]]; then
        printf 'dotfiles: local theme output is missing\n' >&2
        printf 'Run `./dotfiles theme NAME` before linking or checking.\n' >&2
        return 1
    fi

    local current
    current="$(theme_current)"
    "$THEME_RENDERER" --check "$DOTFILES_ROOT" "$current"
}

theme_list() {
    jq -r '
        to_entries[]
        | [.key, .value.name, .value.variant]
        | @tsv
    ' "$THEME_CATALOG"
}

theme_command() {
    require_command jq
    require_command python3

    if [[ "$#" -gt 1 ]]; then
        printf 'Usage: ./dotfiles theme [NAME|--list|--current|--reload]\n' >&2
        return 2
    fi

    local requested=${1-}
    case "$requested" in
        -h | --help)
            cat <<'EOF'
Usage: ./dotfiles theme [NAME|--list|--current|--reload]

With no name, choose a theme interactively with fzf.
  --list     List available themes
  --current  Print the tracked selected theme
  --reload   Regenerate the tracked selected theme
EOF
            return
            ;;
        --list)
            theme_list
            return
            ;;
        --current)
            theme_current
            return
            ;;
        --reload)
            requested="$(theme_current)"
            ;;
        '')
            require_command fzf
            local choice
            choice="$(
                theme_list |
                    fzf \
                        --height=60% \
                        --layout=reverse \
                        --border \
                        --delimiter=$'\t' \
                        --with-nth=2,3 \
                        --prompt='theme › ' \
                        --header='name / variant'
            )"
            [[ -n "$choice" ]] || return
            requested="${choice%%$'\t'*}"
            ;;
    esac

    if ! jq -e --arg name "$requested" 'has($name)' \
        "$THEME_CATALOG" >/dev/null; then
        printf 'dotfiles: unknown theme: %s\n' "$requested" >&2
        printf 'Run `./dotfiles theme --list` to see available names.\n' >&2
        return 2
    fi

    "$THEME_RENDERER" "$DOTFILES_ROOT" "$requested"

    local display
    display="$(
        jq -r --arg name "$requested" '.[$name].name' "$THEME_CATALOG"
    )"
    printf 'Generated local theme files for %s (%s).\n' \
        "$display" "$requested"

    local scheme_source
    local scheme_target
    local scheme
    IFS= read -r scheme <"$THEME_LOCAL_STATE/kde-scheme"
    scheme_source="$DOTFILES_ROOT/kde/$scheme.colors"
    scheme_target="$HOME/.local/share/color-schemes/$scheme.colors"
    if [[ "$DOTFILES_TARGET" == "$HOME" ]] &&
        link_matches "$scheme_source" "$scheme_target"; then
        apply_settings
    else
        printf 'Run `./dotfiles link` and `./dotfiles apply` to install it.\n'
    fi
}

apply_settings() {
    require_generated_theme
    run_module_hooks apply
    run_module_hooks reload
    printf 'Applied enabled application settings.\n'
}

check_json() {
    require_command jq

    local json_file
    local -a json_files=()
    mapfile -d '' -t json_files < <(
        git -C "$DOTFILES_ROOT" ls-files -co -z --exclude-standard -- '*.json'
    )
    local index
    for index in "${!json_files[@]}"; do
        json_files[index]="$DOTFILES_ROOT/${json_files[index]}"
    done
    json_files+=(
        "$DOTFILES_ROOT/vscode/extension/package.json"
        "$DOTFILES_ROOT/vscode/extension/themes/nulifyer.json"
        "$DOTFILES_ROOT/opencode/themes/nulifyer.json"
    )

    for json_file in "${json_files[@]}"; do
        [[ -f "$json_file" ]] || continue
        jq -e . "$json_file" >/dev/null
    done
    validate_deployments

    jq -e '
        length > 0 and
        all(.[]; (.variant == "dark" or .variant == "light") and
            (.prompt | keys | length) == 7 and
            (.terminal.normal | keys | length) == 8 and
            (.terminal.bright | keys | length) == 8)
    ' "$THEME_CATALOG" >/dev/null
    "$THEME_RENDERER" --validate
}

check_sources() {
    bash -n "$DOTFILES_ROOT/dotfiles" "$DOTFILES_ROOT/.dotfiles/lib.sh"
    python3 - \
        "$MODULE_RUNNER" \
        "$DOTFILES_ROOT/.dotfiles/kconfig.py" \
        "$DOTFILES_ROOT/.theme/audit.py" \
        "$THEME_RENDERER" \
        "$DOTFILES_ROOT/.theme/check_kde.py" \
        "$DOTFILES_ROOT/.theme/test_golden.py" \
        "$DOTFILES_ROOT/kde/apply_scheme.py" <<'PY'
import pathlib
import sys

for name in sys.argv[1:]:
    path = pathlib.Path(name)
    compile(path.read_text(), path.name, "exec")
PY
    python3 "$DOTFILES_ROOT/.tests/modules.py"
    python3 "$DOTFILES_ROOT/.theme/audit.py"
    python3 "$DOTFILES_ROOT/.theme/test_golden.py"
    run_module_hooks validate true
}

check_dependencies() {
    validate_deployments
}

check_deployment_layout() {
    validate_deployments
}

check_generated_theme() {
    require_generated_theme
}

check_links() {
    local failed=false
    local name source_root target source_kind install_method module
    local target_root source relative installed
    local -A expected_targets=()
    local -A target_directories=()

    while IFS=$'\t' read -r name source_root target source_kind install_method module; do
        target_root="$(deployment_target_root "$target")"
        if [[ "$source_kind" == directory ]]; then
            expected_targets["$target_root"]=1
            target_directories["$(dirname -- "$target_root")"]=1
            if ! link_matches "$DOTFILES_ROOT/$source_root" "$target_root"; then
                printf 'dotfiles: directory-link drift: %s -> %s\n' \
                    "$target_root" "$DOTFILES_ROOT/$source_root" >&2
                failed=true
            fi
            continue
        elif [[ "$source_kind" == file ]]; then
            expected_targets["$target_root"]=1
            target_directories["$(dirname -- "$target_root")"]=1
            if ! deployment_matches \
                "$DOTFILES_ROOT/$source_root" "$target_root" "$install_method"; then
                printf 'dotfiles: %s drift: %s (source %s)\n' \
                    "$install_method" "$target_root" "$DOTFILES_ROOT/$source_root" >&2
                failed=true
            fi
            continue
        fi

        while IFS= read -r -d '' source; do
            source="$DOTFILES_ROOT/$source"
            relative="${source#"$DOTFILES_ROOT/$source_root/"}"
            installed="$target_root/$relative"
            expected_targets["$installed"]=1
            target_directories["$(dirname -- "$installed")"]=1
            if ! deployment_matches "$source" "$installed" "$install_method"; then
                printf 'dotfiles: %s drift: %s (source %s)\n' \
                    "$install_method" "$installed" "$source" >&2
                failed=true
            fi
        done < <(deployment_source_files "$name")
    done < <(deployment_rows)

    local directory installed_link
    local raw_destination resolved_destination
    for directory in "${!target_directories[@]}"; do
        [[ -d "$directory" ]] || continue
        while IFS= read -r -d '' installed_link; do
            [[ -n "${expected_targets[$installed_link]:-}" ]] && continue
            raw_destination="$(readlink -- "$installed_link")"
            if [[ "$raw_destination" == /* ]]; then
                resolved_destination="$(readlink -m -- "$raw_destination")"
            else
                resolved_destination="$(
                    readlink -m -- "$directory/$raw_destination"
                )"
            fi
            if [[ "$resolved_destination" == "$DOTFILES_ROOT/"* ]]; then
                printf 'dotfiles: obsolete managed link: %s -> %s\n' \
                    "$installed_link" "$raw_destination" >&2
                failed=true
            fi
        done < <(find "$directory" -maxdepth 1 -type l -print0)
    done

    [[ "$failed" == false ]]
}

check_module_settings() {
    run_module_hooks check
}

check_all() {
    printf 'Validating dotfiles...\n'
    git -C "$DOTFILES_ROOT" diff --check HEAD
    check_generated_theme
    check_json
    check_sources
    check_dependencies
    check_deployment_layout
    check_links
    check_module_settings
    printf 'All local checks passed.\n'
}

show_status() {
    printf 'Repository: %s\n' "$DOTFILES_ROOT"
    printf 'Target:     %s\n' "$DOTFILES_TARGET"
    printf '\nApplication modules:\n'
    python3 "$MODULE_RUNNER" --root "$DOTFILES_ROOT" modules
    printf '\nGit status:\n'
    git -C "$DOTFILES_ROOT" status --short
    printf '\nConfigured MCP servers:\n'
    if command -v codex >/dev/null 2>&1; then
        codex mcp list
    else
        printf 'Codex is not installed.\n'
    fi
}

update_all() {
    git -C "$DOTFILES_ROOT" pull --ff-only
    theme_command --reload
    link_packages
    apply_settings
    check_all
}

main() {
    local command_name="${1:-help}"

    if [[ "$command_name" != theme && "$command_name" != doctor &&
        "$#" -gt 1 ]]; then
        printf 'dotfiles: unexpected argument: %s\n' "$2" >&2
        usage >&2
        return 2
    fi

    case "$command_name" in
        link)
            link_packages
            ;;
        apply)
            apply_settings
            ;;
        theme)
            theme_command "${@:2}"
            ;;
        check)
            check_all
            ;;
        doctor)
            doctor_command "${@:2}"
            ;;
        update)
            update_all
            ;;
        status)
            show_status
            ;;
        unlink)
            unlink_packages
            ;;
        help | -h | --help)
            usage
            ;;
        *)
            printf 'dotfiles: unknown command: %s\n' "$command_name" >&2
            usage >&2
            return 2
            ;;
    esac
}

main "$@"
