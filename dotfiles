#!/usr/bin/env bash

set -euo pipefail

DOTFILES_SCRIPT_PATH="$(readlink -f -- "${BASH_SOURCE[0]}")"
readonly DOTFILES_SCRIPT_PATH
DOTFILES_ROOT="$(
    cd -- "$(dirname -- "$DOTFILES_SCRIPT_PATH")"
    pwd -P
)"
readonly DOTFILES_ROOT
readonly DOTFILES_TARGET="${DOTFILES_TARGET:-$HOME}"
readonly MODULE_RUNNER="$DOTFILES_ROOT/.dotfiles/modules.py"
readonly THEME_RENDERER="$DOTFILES_ROOT/.theme/render.py"
readonly THEME_LOCAL_STATE="$DOTFILES_ROOT/.theme/local"
declare -a ACTIVE_DEPLOYMENTS=()
declare -a ALL_DEPLOYMENTS=()
declare -a APPLY_HOOKS=()
declare -a RELOAD_HOOKS=()
declare -A DEPLOYMENT_FILES=()
declare -A DEPLOYMENT_PRESERVES=()
MODULE_PLAN_READY=false

require_command() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'dotfiles: required command not found: %s\n' "$1" >&2
        exit 1
    fi
}

link_matches() {
    local source=$1
    local target=$2
    [[ -L "$target" ]] &&
        [[ "$(readlink -f -- "$target")" == "$(readlink -f -- "$source")" ]]
}

link_points_into_repository() {
    local target=$1
    [[ -L "$target" ]] || return 1
    local destination
    destination="$(readlink -m -- "$(dirname -- "$target")/$(readlink -- "$target")")"
    [[ "$destination" == "$DOTFILES_ROOT/"* ]]
}

deployment_rows() {
    local row
    for row in "${ACTIVE_DEPLOYMENTS[@]}"; do
        printf '%s\n' "$row"
    done
}

all_deployment_rows() {
    local row
    for row in "${ALL_DEPLOYMENTS[@]}"; do
        printf '%s\n' "$row"
    done
}

deployment_preserve_paths() {
    local values=${DEPLOYMENT_PRESERVES[$1]-}
    [[ -n "$values" ]] || return
    printf '%s' "$values"
}

deployment_source_files() {
    local values=${DEPLOYMENT_FILES[$1]-}
    local path
    [[ -n "$values" ]] || return
    while IFS= read -r path; do
        [[ -n "$path" ]] && printf '%s\0' "$path"
    done <<<"$values"
}

deployment_target_root() {
    local target=$1
    if [[ "$target" == . ]]; then
        printf '%s\n' "$DOTFILES_TARGET"
    else
        printf '%s/%s\n' "$DOTFILES_TARGET" "$target"
    fi
}

run_module_hooks() {
    local action=$1
    local -a hooks=()
    [[ "$action" == apply ]] && hooks=("${APPLY_HOOKS[@]}")
    [[ "$action" == reload ]] && hooks=("${RELOAD_HOOKS[@]}")
    local row module hook
    local failed=false
    for row in "${hooks[@]}"; do
        IFS=$'\t' read -r module hook <<<"$row"
        if ! env \
            DOTFILES_ROOT="$DOTFILES_ROOT" \
            DOTFILES_TARGET="$DOTFILES_TARGET" \
            DOTFILES_MODULE="$module" \
            bash "$hook"; then
            failed=true
        fi
    done
    [[ "$failed" == false ]]
}

prepare_module_plan() {
    [[ "$MODULE_PLAN_READY" == false ]] || return
    local record type active identifier source target kind install module
    local action path row plan_file
    plan_file="$(mktemp)"
    if ! python3 "$MODULE_RUNNER" "$DOTFILES_ROOT" >"$plan_file"; then
        unlink "$plan_file"
        return 1
    fi
    while IFS= read -r -d '' record; do
        IFS=$'\t' read -r type active identifier source target kind install module \
            <<<"$record"
        case "$type" in
            deployment)
                row="$identifier"$'\t'"$source"$'\t'"$target"$'\t'
                row+="$kind"$'\t'"$install"$'\t'"$module"
                ALL_DEPLOYMENTS+=("$row")
                [[ "$active" == 1 ]] && ACTIVE_DEPLOYMENTS+=("$row")
                ;;
            file)
                DEPLOYMENT_FILES["$active"]+="$identifier"$'\n'
                ;;
            preserve)
                DEPLOYMENT_PRESERVES["$active"]+="$identifier"$'\n'
                ;;
            hook)
                action=$identifier
                module=$source
                path=$target
                [[ "$active" == 1 ]] || continue
                row="$module"$'\t'"$path"
                [[ "$action" == apply ]] && APPLY_HOOKS+=("$row")
                [[ "$action" == reload ]] && RELOAD_HOOKS+=("$row")
                ;;
        esac
    done <"$plan_file"
    unlink "$plan_file"
    MODULE_PLAN_READY=true
}

deployment_matches() {
    local source=$1
    local target=$2
    local install_method=$3
    if [[ "$install_method" == link ]]; then
        link_matches "$source" "$target"
    else
        [[ -f "$target" && ! -L "$target" ]] && cmp -s -- "$source" "$target"
    fi
}

replace_link_conflicts() {
    local name source_root target_root source_kind install_method module
    local source relative target choice
    local failed=false
    local -a conflict_sources=()
    local -a conflict_targets=()
    local -a conflict_choices=()

    while IFS=$'\t' read -r name source_root target_root source_kind install_method module; do
        [[ "$source_kind" != directory ]] || continue
        if [[ "$source_kind" == file ]]; then
            source="$DOTFILES_ROOT/$source_root"
            target="$(deployment_target_root "$target_root")"
            deployment_matches "$source" "$target" "$install_method" && continue
            if link_points_into_repository "$target"; then
                rm -f -- "$target"
                continue
            fi
            if [[ -d "$target" && ! -L "$target" ]]; then
                printf 'dotfiles: refusing to replace directory: %s\n' \
                    "$target" >&2
                failed=true
            elif [[ -e "$target" || -L "$target" ]]; then
                conflict_sources+=("$source")
                conflict_targets+=("$target")
            fi
            continue
        fi
        target_root="$(deployment_target_root "$target_root")"
        while IFS= read -r -d '' source; do
            source="$DOTFILES_ROOT/$source"
            relative="${source#"$DOTFILES_ROOT/$source_root/"}"
            target="$target_root/$relative"
            deployment_matches "$source" "$target" "$install_method" && continue
            if link_points_into_repository "$target"; then
                rm -f -- "$target"
                continue
            fi

            if [[ -d "$target" && ! -L "$target" ]]; then
                printf 'dotfiles: refusing to replace directory: %s\n' \
                    "$target" >&2
                failed=true
            elif [[ -e "$target" || -L "$target" ]]; then
                conflict_sources+=("$source")
                conflict_targets+=("$target")
            fi
        done < <(deployment_source_files "$name")
    done < <(deployment_rows)

    [[ "$failed" == false ]] || return 1

    local index
    for index in "${!conflict_targets[@]}"; do
        source="${conflict_sources[$index]}"
        target="${conflict_targets[$index]}"
        while true; do
            printf 'Conflict: %s\n' "$target"
            printf '  [r] Keep repository version: %s\n' "$source"
            printf '  [t] Keep target version and import it into the repository\n'
            printf '  [a] Abort\n'
            printf 'Choose [r/t/a]: '
            if ! IFS= read -r choice; then
                printf '\ndotfiles: no conflict choice received; aborting\n' >&2
                return 1
            fi
            case "${choice,,}" in
                r | repository)
                    conflict_choices+=(repository)
                    break
                    ;;
                t | target)
                    conflict_choices+=(target)
                    break
                    ;;
                a | abort | '')
                    printf 'dotfiles: linking aborted\n' >&2
                    return 1
                    ;;
                *)
                    printf 'Enter r, t, or a.\n' >&2
                    ;;
            esac
        done
    done

    for index in "${!conflict_targets[@]}"; do
        source="${conflict_sources[$index]}"
        target="${conflict_targets[$index]}"
        if [[ "${conflict_choices[$index]}" == repository ]]; then
            printf 'Keeping repository version: %s\n' "$source"
            rm -f -- "$target"
        else
            printf 'Importing target version into repository: %s\n' "$source"
            mv -fT -- "$target" "$source"
        fi
    done
}

path_is_preserved() {
    local relative=$1
    shift
    local preserve
    for preserve in "$@"; do
        if [[ "$relative" == "$preserve" ||
            "$relative" == "$preserve/"* ]]; then
            return 0
        fi
    done
    return 1
}

migrate_directory_target() {
    local name=$1
    local source=$2
    local target=$3
    local -a preserve_paths=()
    mapfile -t preserve_paths < <(deployment_preserve_paths "$name")

    local preserve source_path target_path
    for preserve in "${preserve_paths[@]}"; do
        source_path="$source/$preserve"
        target_path="$target/$preserve"
        if [[ -e "$target_path" || -L "$target_path" ]]; then
            if [[ -e "$source_path" || -L "$source_path" ]]; then
                printf 'dotfiles: cannot preserve %s; source already exists: %s\n' \
                    "$target_path" "$source_path" >&2
                return 1
            fi
        fi
    done

    local installed relative expected failed=false
    while IFS= read -r -d '' installed; do
        relative="${installed#"$target/"}"
        path_is_preserved "$relative" "${preserve_paths[@]}" && continue
        expected="$source/$relative"
        if [[ ! -f "$expected" && ! -L "$expected" ]]; then
            printf 'dotfiles: unmanaged file blocks directory deployment: %s\n' \
                "$installed" >&2
            failed=true
        elif ! link_matches "$expected" "$installed" &&
            ! { [[ -f "$installed" && ! -L "$installed" ]] &&
                cmp -s -- "$expected" "$installed"; }; then
            printf 'dotfiles: file differs before directory deployment: %s\n' \
                "$installed" >&2
            failed=true
        fi
    done < <(find "$target" \( -type f -o -type l \) -print0)
    [[ "$failed" == false ]] || return 1

    printf 'Migrating %s runtime state into %s...\n' "$name" "$source"
    for preserve in "${preserve_paths[@]}"; do
        source_path="$source/$preserve"
        target_path="$target/$preserve"
        if [[ -e "$target_path" || -L "$target_path" ]]; then
            mkdir -p -- "$(dirname -- "$source_path")"
            mv -- "$target_path" "$source_path"
        fi
    done

    while IFS= read -r -d '' installed; do
        relative="${installed#"$target/"}"
        path_is_preserved "$relative" "${preserve_paths[@]}" && continue
        rm -f -- "$installed"
    done < <(find "$target" \( -type f -o -type l \) -print0)

    local directory
    while IFS= read -r -d '' directory; do
        rmdir -- "$directory"
    done < <(find "$target" -depth -type d -print0)
}

deploy_contents() {
    local name=$1
    local source_root=$2
    local target_root=$3
    local install_method=$4
    local source relative target
    while IFS= read -r -d '' source; do
        source="$DOTFILES_ROOT/$source"
        relative="${source#"$source_root/"}"
        target="$target_root/$relative"
        deploy_file "$source" "$target" "$install_method"
    done < <(deployment_source_files "$name")
}

deploy_file() {
    local source=$1
    local target=$2
    local install_method=$3
    deployment_matches "$source" "$target" "$install_method" && return
    mkdir -p -- "$(dirname -- "$target")"
    if [[ "$install_method" == link ]]; then
        ln -sr -- "$source" "$target"
        return
    fi

    local temporary
    temporary="$(mktemp "$(dirname -- "$target")/.dotfiles-copy.XXXXXX")"
    if ! cp --preserve=mode --reflink=auto -- "$source" "$temporary"; then
        rm -f -- "$temporary"
        return 1
    fi
    mv -fT -- "$temporary" "$target"
}

deploy_directory() {
    local name=$1
    local source=$2
    local target=$3
    link_matches "$source" "$target" && return

    if [[ -d "$target" && ! -L "$target" ]]; then
        migrate_directory_target "$name" "$source" "$target"
    elif link_points_into_repository "$target"; then
        local old_source preserve old_path new_path
        old_source="$(readlink -f -- "$target")"
        printf 'Relocating %s directory deployment to %s...\n' \
            "$name" "$source"
        while IFS= read -r preserve; do
            old_path="$old_source/$preserve"
            new_path="$source/$preserve"
            if [[ ! -e "$old_path" && ! -L "$old_path" ]]; then
                continue
            fi
            if [[ -e "$new_path" || -L "$new_path" ]]; then
                printf 'dotfiles: cannot relocate %s; destination exists: %s\n' \
                    "$old_path" "$new_path" >&2
                return 1
            fi
            mkdir -p -- "$(dirname -- "$new_path")"
            mv -- "$old_path" "$new_path"
        done < <(deployment_preserve_paths "$name")
        rm -f -- "$target"
    elif [[ -e "$target" || -L "$target" ]]; then
        printf 'dotfiles: target blocks directory deployment: %s\n' \
            "$target" >&2
        return 1
    fi

    mkdir -p -- "$(dirname -- "$target")"
    ln -sr -- "$source" "$target"
}

reconcile_files() {
    prepare_module_plan
    replace_link_conflicts
    printf 'Reconciling files in %s...\n' "$DOTFILES_TARGET"

    local name source target source_kind install_method module target_root
    while IFS=$'\t' read -r name source target source_kind install_method module; do
        target_root="$(deployment_target_root "$target")"
        if [[ "$source_kind" == file ]]; then
            deploy_file "$DOTFILES_ROOT/$source" "$target_root" "$install_method"
        elif [[ "$source_kind" == contents ]]; then
            deploy_contents \
                "$name" "$DOTFILES_ROOT/$source" "$target_root" "$install_method"
        else
            deploy_directory "$name" "$DOTFILES_ROOT/$source" "$target_root"
        fi
    done < <(deployment_rows)
}

cleanup_obsolete_links() {
    local name source_root target source_kind install_method module
    local target_root source relative installed_link destination
    local -A expected_targets=()
    local -A target_directories=()
    local -A recursive_targets=()

    while IFS=$'\t' read -r name source_root target source_kind install_method module; do
        target_root="$(deployment_target_root "$target")"
        if [[ "$source_kind" == directory || "$source_kind" == file ]]; then
            expected_targets["$target_root"]=1
            target_directories["$(dirname -- "$target_root")"]=1
            continue
        fi
        while IFS= read -r -d '' source; do
            source="$DOTFILES_ROOT/$source"
            relative="${source#"$DOTFILES_ROOT/$source_root/"}"
            expected_targets["$target_root/$relative"]=1
            target_directories["$(dirname -- "$target_root/$relative")"]=1
        done < <(deployment_source_files "$name")
    done < <(deployment_rows)

    while IFS=$'\t' read -r name source_root target source_kind install_method module; do
        target_root="$(deployment_target_root "$target")"
        if [[ "$source_kind" == file || "$source_kind" == directory ]]; then
            target_directories["$(dirname -- "$target_root")"]=1
        else
            recursive_targets["$target_root"]=1
        fi
    done < <(all_deployment_rows)

    remove_obsolete_links() {
        while IFS= read -r -d '' installed_link; do
            [[ -n "${expected_targets[$installed_link]:-}" ]] && continue
            destination="$(readlink -- "$installed_link")"
            if [[ "$destination" != /* ]]; then
                destination="$(readlink -m -- \
                    "$(dirname -- "$installed_link")/$destination")"
            fi
            if [[ "$destination" == "$DOTFILES_ROOT/"* ]]; then
                printf 'Removing obsolete managed link %s\n' "$installed_link"
                rm -f -- "$installed_link"
            fi
        done
    }

    for target_root in "${!recursive_targets[@]}"; do
        [[ -d "$target_root" ]] || continue
        find "$target_root" -type l -print0 | remove_obsolete_links
    done
    for target_root in "${!target_directories[@]}"; do
        [[ -d "$target_root" ]] || continue
        find "$target_root" -maxdepth 1 -type l -print0 | remove_obsolete_links
    done
    unset -f remove_obsolete_links
}

theme_current() {
    local current_file="$THEME_LOCAL_STATE/current"
    if [[ -r "$current_file" ]]; then
        local current
        IFS= read -r current <"$current_file"
        printf '%s\n' "$current"
    else
        printf '%s\n' gruvbox
    fi
}

apply() {
    require_command python3
    local theme=${DOTFILES_THEME:-$(theme_current)}
    "$THEME_RENDERER" "$DOTFILES_ROOT" "$theme"
    reconcile_files
    cleanup_obsolete_links
    printf 'Applying app settings and reloads...\n'
    run_module_hooks apply
    run_module_hooks reload
    printf 'Dotfiles are applied.\n'
}

main() {
    if [[ "$#" -ne 0 ]]; then
        printf 'Usage: ./dotfiles\n' >&2
        return 2
    fi
    apply
}

main "$@"
