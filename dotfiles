    'kwinrulesrc|nulifyer-project-picker|Description|Centered project picker'
    'kwinrulesrc|nulifyer-project-picker|Enabled|true'
    'kwinrulesrc|nulifyer-project-picker|placement|5'
    'kwinrulesrc|nulifyer-project-picker|placementrule|2'
    'kwinrulesrc|nulifyer-project-picker|types|1'
    'kwinrulesrc|nulifyer-project-picker|wmclass|nulifyer-project-picker'
    'kwinrulesrc|nulifyer-project-picker|wmclasscomplete|false'
