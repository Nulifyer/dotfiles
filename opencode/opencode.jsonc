{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "caveboss",
  "small_model": "openai/gpt-5.6-luna",
  "shell": "/usr/bin/fish",
  "instructions": [
    "AGENTS.md"
  ],
  "lsp": {},
  "permission": {
    "read": {
      ".env": "ask",
      ".env.*": "ask",
      ".env-*": "ask"
    },
    "doom_loop": "ask",
    "memory.*": "ask",
    "skill_candidate.*": "ask",
    "vscode.read": "ask",
    "vscode.open_file": "ask",
    "vscode.execute_terminal": "ask",
    "vscode.open_url": "ask",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/var/tmp/**": "allow",
      "~/.cache/**": "allow",
      "~/Projects/**": "ask"
    },
    "bash": {
      "*": "ask",
      // Remote mutation always requires confirmation.
      "git push": "ask",
      "git push *": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      // Hard denies: destructive or unsafe commands. Keep last so they override allow/ask rules.
      ":(){:|:&};:": "deny", // fork bomb, just in case
      "*; chmod*": "deny",
      "*; chown*": "deny",
      "*; dd*": "deny",
      "*| chmod*": "deny",
      "*| chown*": "deny",
      "*| dd*": "deny",
      "chmod*": "deny",
      "chown*": "deny",
      "dd*": "deny",
      "eval*": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm*": "deny",
      "rmdir*": "deny",
      "sudo *": "deny",
      "wget*": "deny",
      "xargs*": "deny"
    }
  }
}
