{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "caveboss",
  "shell": "/usr/bin/fish",
  "instructions": [
    "AGENTS.md"
  ],
  "lsp": {},
  "permission": {
    "read": {
      ".env": "allow",
      ".env.*": "allow",
      ".env-*": "allow"
    },
    "doom_loop": "ask",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "/var/tmp/**": "allow",
      "~/.cache/**": "allow",
      "~/Projects/**": "allow"
    },
    "bash": {
      "*": "ask",
      // Explicitly approved network operations.
      "git push": "allow",
      "git push *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      // Hard denies: destructive or unsafe commands. Keep last so they override allow/ask rules.
      ":(){:|:&};:": "deny", // fork bomb, just in case
      "*; chmod*": "deny",
      "*; chown*": "deny",
      "*; dd*": "deny",
      "*| chmod*": "deny",
      "*| chown*": "deny",
      "*| dd*": "deny",
      "chmod*": "deny",
      "chown*": "deny",
      "dd*": "deny",
      "eval*": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "rm*": "deny",
      "rmdir*": "deny",
      "sudo *": "deny",
      "wget*": "deny",
      "xargs*": "deny"
    },
  },
  "plugin": [
    "@prevalentware/opencode-goal-plugin"
  ],
}
