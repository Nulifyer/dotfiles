{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "main",
  "shell": "C:\\Program Files\\PowerShell\\7\\pwsh.exe",
  "lsp": {},
  "permission": {
    // Most non-shell tools use opencode defaults. This preserves built-in .env read protection.
    "doom_loop": "ask",
    "external_directory": {
      "*": "ask",
      "~/AppData/Local/Temp/**": "allow"
    },
    "bash": {
      // opencode uses the last matching permission rule. Order here is: default ask, broad asks, safe allows, write asks, hard denies.
      "*": "ask",

      // Broad mutating defaults. Specific safe exceptions can override these later.
      "git clone*": "ask",

      // Safe file, workspace, and PowerShell inspection.
      "$PSVersionTable*": "allow",
      "cat*": "allow",
      "dir*": "allow",
      "findstr*": "allow",
      "Get-Alias*": "allow",
      "Get-ChildItem*": "allow",
      "Get-Command*": "allow",
      "Get-Content*": "allow",
      "Get-Date*": "allow",
      "Get-FileHash*": "allow",
      "Get-Help*": "allow",
      "Get-Item*": "allow",
      "Get-Location*": "allow",
      "Get-Member*": "allow",
      "Get-Module*": "allow",
      "Get-Process*": "allow",
      "Get-Service*": "allow",
      "grep*": "allow",
      "Join-Path*": "allow",
      "ls*": "allow",
      "pwd*": "allow",
      "Resolve-Path*": "allow",
      "rg*": "allow",
      "Select-String*": "allow",
      "Split-Path*": "allow",
      "Test-Path*": "allow",
      "tree*": "allow",
      "where*": "allow",
      "which*": "allow",
      "whoami*": "allow",

      // Secret-bearing files and environment variables should still prompt, even through shell reads.
      "* .env": "ask",
      "* .env.*": "ask",
      "* .env*": "ask",
      "*/*.env*": "ask",
      "*\\.env*": "ask",
      "dir Env:*": "ask",
      "dir env:*": "ask",
      "Get-ChildItem Env:*": "ask",
      "Get-ChildItem env:*": "ask",
      "Get-Content Env:*": "ask",
      "Get-Content env:*": "ask",
      "Get-Item Env:*": "ask",
      "Get-Item env:*": "ask",
      "ls Env:*": "ask",
      "ls env:*": "ask",
      "* .env.example": "allow",
      "* .env.example.*": "allow",
      "*/*.env.example": "allow",
      "*/*.env.example.*": "allow",
      "*\\.env.example": "allow",
      "*\\.env.example.*": "allow",

      // Safe PowerShell data conversion and shaping.
      "Compare-Object*": "allow",
      "ConvertFrom-Csv*": "allow",
      "ConvertFrom-Json*": "allow",
      "ConvertFrom-StringData*": "allow",
      "ConvertTo-Csv*": "allow",
      "ConvertTo-Json*": "allow",
      "ForEach-Object*": "allow",
      "Format-Custom*": "allow",
      "Format-List*": "allow",
      "Format-Table*": "allow",
      "Format-Wide*": "allow",
      "Get-Content * | ConvertFrom-Json*": "allow",
      "Get-Content * | ConvertFrom-Json* | Out-Null*": "allow",
      "Group-Object*": "allow",
      "Import-Csv*": "allow",
      "Measure-Object*": "allow",
      "Out-Null*": "allow",
      "Out-String*": "allow",
      "Select-Object*": "allow",
      "Sort-Object*": "allow",
      "Test-Json*": "allow",
      "Where-Object*": "allow",
      "Write-Host*": "allow",
      "Write-Output*": "allow",

      // Safe version checks.
      "* --version": "allow",
      "* -version": "allow",
      "* -V": "allow",
      "* version": "allow",
      "* /version": "allow",
      "* /Version": "allow",

      // Safe help and manual checks.
      "* --help": "allow",
      "* -help": "allow",
      "* /?": "allow",
      "* help": "allow",
      "* help *": "allow",
      "help": "allow",
      "help *": "allow",
      "man": "allow",
      "man *": "allow",

      // Safe validation and format checks.
      "black --check*": "allow",
      "biome check*": "allow",
      "cargo fmt --check*": "allow",
      "deno fmt --check*": "allow",
      "gofmt -d*": "allow",
      "gofmt -l*": "allow",
      "node --check*": "allow",
      "npm run format:check*": "allow",
      "pnpm format:check*": "allow",
      "prettier --check*": "allow",
      "prettier --list-different*": "allow",
      "python -m json.tool*": "allow",
      "ruff format --check*": "allow",
      "yarn format:check*": "allow",

      // Safe Git inspection.
      "git branch*": "allow",
      "git diff*": "allow",
      "git diff -- *": "allow",
      "git grep*": "allow",
      "git log*": "allow",
      "git ls-files*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git show*": "allow",
      "git status*": "allow",

      // Safe temporary clones for investigation.
      "git clone * $env:TEMP\\*": "allow",
      "git clone * $env:TEMP/*": "allow",
      "git clone * \"$env:TEMP\\*\"": "allow",
      "git clone * \"$env:TEMP/*\"": "allow",
      "git clone * C:\\Users\\kel80\\AppData\\Local\\Temp\\*": "allow",
      "git clone * C:/Users/kel80/AppData/Local/Temp/*": "allow",
      "git clone * \"C:\\Users\\kel80\\AppData\\Local\\Temp\\*\"": "allow",
      "git clone * \"C:/Users/kel80/AppData/Local/Temp/*\"": "allow",

      // Safe package inspection and deterministic installs.
      "npm audit": "allow",
      "npm audit*": "allow",
      "npm ci": "allow",
      "npm ci*": "allow",
      "npm list*": "allow",
      "npm outdated*": "allow",
      "pnpm install --frozen-lockfile*": "allow",
      "pnpm list*": "allow",
      "pnpm why*": "allow",
      "yarn install --frozen-lockfile*": "allow",
      "yarn list*": "allow",

      // Safe build, test, lint, and typecheck commands.
      "./gradlew test*": "allow",
      "bun run build*": "allow",
      "bun run test*": "allow",
      "bun test*": "allow",
      "cargo check*": "allow",
      "cargo clippy*": "allow",
      "cargo nextest run*": "allow",
      "cargo test*": "allow",
      "deno check*": "allow",
      "deno task build*": "allow",
      "deno test*": "allow",
      "dotnet build*": "allow",
      "dotnet format --verify-no-changes*": "allow",
      "dotnet test*": "allow",
      "eslint*": "allow",
      "go build*": "allow",
      "go test*": "allow",
      "gradle build*": "allow",
      "gradle test*": "allow",
      "jest*": "allow",
      "mvn test*": "allow",
      "mypy*": "allow",
      "nox*": "allow",
      "npm run build*": "allow",
      "npm run lint*": "allow",
      "npm run test*": "allow",
      "npm run typecheck*": "allow",
      "npm test*": "allow",
      "npx eslint*": "allow",
      "npx jest*": "allow",
      "npx tsc*": "allow",
      "npx vitest*": "allow",
      "pnpm build*": "allow",
      "pnpm run build*": "allow",
      "pnpm lint*": "allow",
      "pnpm test*": "allow",
      "pnpm typecheck*": "allow",
      "poetry run mypy*": "allow",
      "poetry run pytest*": "allow",
      "poetry run ruff*": "allow",
      "py -m pytest*": "allow",
      "py -m unittest*": "allow",
      "pytest*": "allow",
      "pyright*": "allow",
      "python -m pytest*": "allow",
      "python -m unittest*": "allow",
      "ruff check*": "allow",
      "tox*": "allow",
      "tsc*": "allow",
      "uv run mypy*": "allow",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "vitest*": "allow",
      "yarn build*": "allow",
      "yarn lint*": "allow",
      "yarn run build*": "allow",
      "yarn test*": "allow",
      "yarn typecheck*": "allow",

      // Safe container inspection and approved local image builds.
      "docker compose logs*": "allow",
      "docker compose ps*": "allow",
      "docker images*": "allow",
      "docker info*": "allow",
      "docker inspect*": "allow",
      "docker logs*": "allow",
      "docker ps*": "allow",
      "docker version*": "allow",
      "podman build*": "allow",
      "podman images*": "allow",
      "podman info*": "allow",
      "podman inspect*": "allow",
      "podman logs*": "allow",
      "podman ps*": "allow",
      "podman version*": "allow",

      // Network fetches. curl is generally okay; writes, uploads, and method/data overrides ask below.
      "curl*": "allow",

      // Ask for commands that mutate files/processes or write command output. Use opencode edit/write tools for file changes.
      "* > *": "ask",
      "* >> *": "ask",
      "*| Add-Content*": "ask",
      "*| Export-Clixml*": "ask",
      "*| Export-Csv*": "ask",
      "*| Out-File*": "ask",
      "*| Set-Content*": "ask",
      "*| Tee-Object*": "ask",
      "Add-Content*": "ask",
      "biome check *--fix*": "ask",
      "biome check *--write*": "ask",
      "cargo clippy *--fix*": "ask",
      "cmd*": "ask",
      "Copy-Item*": "ask",
      "curl*|*": "ask",
      "curl *--data*": "ask",
      "curl *--dump-header*": "ask",
      "curl *--form*": "ask",
      "curl *--output*": "ask",
      "curl *--remote-name*": "ask",
      "curl *--request*": "ask",
      "curl *--upload-file*": "ask",
      "curl *-D*": "ask",
      "curl *-F*": "ask",
      "curl *-T*": "ask",
      "curl *-X*": "ask",
      "curl *-[oO]*": "ask",
      "curl *-d*": "ask",
      "eslint *--fix*": "ask",
      "Export-Clixml*": "ask",
      "Export-Csv*": "ask",
      "git branch *--delete*": "ask",
      "git branch *--force*": "ask",
      "git branch *-[dDmM]*": "ask",
      "git diff *--output*": "ask",
      "git log *--output*": "ask",
      "git show *--output*": "ask",
      "jest *--updateSnapshot*": "ask",
      "Move-Item*": "ask",
      "New-Item*": "ask",
      "npm test *--update*": "ask",
      "npx eslint *--fix*": "ask",
      "npx jest *--updateSnapshot*": "ask",
      "npx vitest *--update*": "ask",
      "Out-File*": "ask",
      "powershell*": "ask",
      "pnpm test *--update*": "ask",
      "poetry run ruff *--fix*": "ask",
      "pwsh*": "ask",
      "pwsh -NoProfile -File *.ps1 validate": "allow",
      "pwsh -NoProfile -File \"*.ps1\" validate": "allow",
      "Rename-Item*": "ask",
      "ruff check *--fix*": "ask",
      "Set-Content*": "ask",
      "Set-Item*": "ask",
      "Start-Job*": "ask",
      "Start-Process*": "ask",
      "Tee-Object*": "ask",
      "uv run ruff *--fix*": "ask",
      "vitest *--update*": "ask",
      "yarn test *--update*": "ask",

      // Hard denies: destructive, unsafe execution, or blocked network aliases. Keep last so they override allow/ask rules.
      "*; chmod*": "deny",
      "*; chown*": "deny",
      "*; dd*": "deny",
      "*; Invoke-Expression*": "deny",
      "*; Remove-Item*": "deny",
      "*; Stop-Process*": "deny",
      "*; taskkill*": "deny",
      "*| chmod*": "deny",
      "*| chown*": "deny",
      "*| dd*": "deny",
      "*| Invoke-Expression*": "deny",
      "*| Remove-Item*": "deny",
      "*| Stop-Process*": "deny",
      "*| taskkill*": "deny",
      "chmod*": "deny",
      "chown*": "deny",
      "dd*": "deny",
      "del*": "deny",
      "erase*": "deny",
      "eval*": "deny",
      "iex*": "deny",
      "Invoke-Expression*": "deny",
      "Invoke-RestMethod*": "deny",
      "Invoke-WebRequest*": "deny",
      "irm*": "deny",
      "iwr*": "deny",
      "kill*": "deny",
      "rd*": "deny",
      "Remove-Item*": "deny",
      "ri*": "deny",
      "rm*": "deny",
      "rmdir*": "deny",
      "Stop-Process*": "deny",
      "taskkill*": "deny",
      "wget*": "deny",
      "xargs*": "deny"
    }
  }
}
