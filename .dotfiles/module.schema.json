{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nulifyer.local/dotfiles/module.schema.json",
  "title": "Dotfiles application module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "deployments"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desktop": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {
          "$ref": "#/$defs/dependencyClasses"
        },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "arch": {
              "$ref": "#/$defs/dependencyClasses"
            }
          }
        }
      }
    },
    "deployments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/deployment"
      }
    }
  },
  "$defs": {
    "dependencyNames": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9@._+-]+$"
      }
    },
    "dependencyClasses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/dependencyNames"
        },
        "managed": {
          "$ref": "#/$defs/dependencyNames"
        },
        "optional": {
          "$ref": "#/$defs/dependencyNames"
        }
      }
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "source",
        "target",
        "kind",
        "install"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "target": {
          "$ref": "#/$defs/safeRelativePath"
        },
        "kind": {
          "enum": [
            "file",
            "contents",
            "directory"
          ]
        },
        "install": {
          "enum": [
            "link",
            "copy"
          ]
        },
        "preserve": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeRelativePath"
          }
        },
        "exclude": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generated": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "directory"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "install": {
                "const": "link"
              }
            }
          }
        }
      ]
    }
  }
}
