{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nulifyer.local/dotfiles/colors.schema.json",
  "title": "Nulifyer theme catalog",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "$ref": "#/$defs/theme"
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "promptHex": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f]{6}$"
    },
    "roleReference": {
      "type": "string",
      "minLength": 1
    },
    "ansi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "black",
        "red",
        "green",
        "yellow",
        "blue",
        "magenta",
        "cyan",
        "white"
      ],
      "properties": {
        "black": { "$ref": "#/$defs/hex" },
        "red": { "$ref": "#/$defs/hex" },
        "green": { "$ref": "#/$defs/hex" },
        "yellow": { "$ref": "#/$defs/hex" },
        "blue": { "$ref": "#/$defs/hex" },
        "magenta": { "$ref": "#/$defs/hex" },
        "cyan": { "$ref": "#/$defs/hex" },
        "white": { "$ref": "#/$defs/hex" }
      }
    },
    "kdeSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "background": { "$ref": "#/$defs/hex" },
        "alternate": { "$ref": "#/$defs/hex" }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "variant",
        "bat_theme",
        "prompt",
        "terminal",
        "roles"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "variant": { "enum": ["dark", "light"] },
        "bat_theme": { "type": "string", "minLength": 1 },
        "lutgen_palette": { "type": "string", "minLength": 1 },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "user", "path", "git", "ok", "err", "duration"],
          "properties": {
            "os": { "$ref": "#/$defs/promptHex" },
            "user": { "$ref": "#/$defs/promptHex" },
            "path": { "$ref": "#/$defs/promptHex" },
            "git": { "$ref": "#/$defs/promptHex" },
            "ok": { "$ref": "#/$defs/promptHex" },
            "err": { "$ref": "#/$defs/promptHex" },
            "duration": { "$ref": "#/$defs/promptHex" }
          }
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bg", "fg", "cursor", "selection", "normal", "bright"],
          "properties": {
            "bg": { "$ref": "#/$defs/hex" },
            "fg": { "$ref": "#/$defs/hex" },
            "cursor": { "$ref": "#/$defs/hex" },
            "selection": { "$ref": "#/$defs/hex" },
            "normal": { "$ref": "#/$defs/ansi" },
            "bright": { "$ref": "#/$defs/ansi" }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "uiBackground": { "$ref": "#/$defs/roleReference" },
            "uiSurface": { "$ref": "#/$defs/roleReference" },
            "uiSurfaceMuted": { "$ref": "#/$defs/roleReference" },
            "uiSurfaceSunken": { "$ref": "#/$defs/roleReference" },
            "uiBorder": { "$ref": "#/$defs/roleReference" },
            "uiHover": { "$ref": "#/$defs/roleReference" },
            "textPrimary": { "$ref": "#/$defs/roleReference" },
            "textDim": { "$ref": "#/$defs/roleReference" },
            "textMuted": { "$ref": "#/$defs/roleReference" },
            "selectionBackground": { "$ref": "#/$defs/roleReference" },
            "selectionAlternate": { "$ref": "#/$defs/roleReference" },
            "selectionForeground": { "$ref": "#/$defs/roleReference" },
            "selectionSubtle": { "$ref": "#/$defs/roleReference" },
            "accent": { "$ref": "#/$defs/roleReference" },
            "link": { "$ref": "#/$defs/roleReference" },
            "match": { "$ref": "#/$defs/roleReference" },
            "find": { "$ref": "#/$defs/roleReference" },
            "bracket": { "$ref": "#/$defs/roleReference" },
            "success": { "$ref": "#/$defs/roleReference" },
            "warning": { "$ref": "#/$defs/roleReference" },
            "error": { "$ref": "#/$defs/roleReference" },
            "info": { "$ref": "#/$defs/roleReference" },
            "conflict": { "$ref": "#/$defs/roleReference" },
            "gitAdded": { "$ref": "#/$defs/roleReference" },
            "gitModified": { "$ref": "#/$defs/roleReference" },
            "gitDeleted": { "$ref": "#/$defs/roleReference" },
            "gitUntracked": { "$ref": "#/$defs/roleReference" },
            "gitIgnored": { "$ref": "#/$defs/roleReference" },
            "gitConflict": { "$ref": "#/$defs/roleReference" },
            "gitStageModified": { "$ref": "#/$defs/roleReference" },
            "gitStageDeleted": { "$ref": "#/$defs/roleReference" },
            "gitRenamed": { "$ref": "#/$defs/roleReference" },
            "gitSubmodule": { "$ref": "#/$defs/roleReference" }
          }
        },
        "kde": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "button": { "$ref": "#/$defs/kdeSet" },
            "complementary": { "$ref": "#/$defs/kdeSet" },
            "header": { "$ref": "#/$defs/kdeSet" },
            "header_inactive": { "$ref": "#/$defs/kdeSet" },
            "selection": { "$ref": "#/$defs/kdeSet" },
            "tooltip": { "$ref": "#/$defs/kdeSet" },
            "view": { "$ref": "#/$defs/kdeSet" },
            "window": { "$ref": "#/$defs/kdeSet" }
          }
        }
      }
    }
  }
}
