[Unit]
Description=Shared OpenCode server for terminal and VS Code clients
After=network.target

[Service]
Type=simple
Environment=OPENCODE_SERVER_USERNAME=opencode
EnvironmentFile=%h/.config/opencode-workbench/server.env
ExecStart=/usr/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
