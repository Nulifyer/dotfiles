# Packages required by the repository task runner and validation.
required bash
required coreutils
required curl
required git
required github-cli
required jq
required python

# Applications or platform components with managed configuration.
managed alacritty
managed fish
managed fzf
managed kconfig
managed kitty
managed plasma-workspace
managed spectacle
managed ttf-cascadia-mono-nerd
managed visual-studio-code-bin
managed zsh
managed opencode

# Enhancements used when installed.
optional bat
optional chafa
optional eza
