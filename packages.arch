# Packages required by the repository task runner and validation.
required bash
required git
required jq
required python

# Applications or platform components with managed configuration.
managed alacritty
managed fish
managed kconfig
managed kitty
managed plasma-workspace
managed spectacle
managed ttf-cascadia-mono-nerd
managed visual-studio-code-bin
managed zsh
managed opencode

# Enhancements used when installed.
optional bat
optional chafa
optional curl
optional eza
optional fzf
